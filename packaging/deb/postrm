#!/bin/sh
# fabricctl postrm.
#   apt remove: only the package goes; the running fabric install (services,
#               CA, vault, directory, data) is left exactly as it is.
#   apt purge:  apt cannot ask for a passphrase (manual 1.3.7.13, 2.1.1.106
#               point 3). With a backup schedule's public key set, fabric is
#               uninstalled after a cold backup bundle sealed to that key, in
#               /var/backups/fabric/ (root only). Without one, only the package
#               goes and fabric is left running: `sudo fabricctl uninstall`
#               removes it, asking for a passphrase for its bundle.
set -e
BASE=/opt
CLI="$BASE/fabric/lib/fabriclib/cli.py"
case "$1" in
    remove)
        if [ -f "$BASE/fabric/config/vars.yaml" ]; then
            echo "fabricctl: package removed; fabric keeps running from $BASE/fabric (nothing deleted)."
            echo "           Remove fabric completely: sudo apt purge fabricctl   (or: sudo fabricctl uninstall)"
        fi
        ;;
    purge)
        if [ -f "$CLI" ] && [ -f "$BASE/fabric/config/vars.yaml" ]; then
            if grep -q '^backup_public_key: *["'"'"']\{0,1\}age1' "$BASE/fabric/config/vars.yaml"; then
                echo "fabricctl: purging — a backup bundle sealed to the schedule's public key, then fabric is uninstalled"
                if ! python3 "$CLI" uninstall --yes --backup --scheduled-key; then
                    echo "fabricctl: uninstall did not finish; fabric is not removed. Start it again: sudo python3 $CLI start; remove it: sudo python3 $CLI uninstall" >&2
                fi
            else
                echo "fabricctl: package purged; fabric keeps running from $BASE/fabric (nothing deleted): apt cannot ask for a"
                echo "           backup's passphrase. Remove fabric with a backup bundle: sudo python3 $CLI uninstall"
            fi
        fi
        ;;
esac
# Bytecode caches written next to the packaged code (by releases before the
# wrapper stopped that) are not dpkg's files: remove them so the folder goes.
case "$1" in
    remove|purge)
        if [ -d /usr/lib/fabricctl ]; then
            find /usr/lib/fabricctl -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true
            find /usr/lib/fabricctl -depth -type d -empty -delete 2>/dev/null || true
        fi
        ;;
esac
exit 0
