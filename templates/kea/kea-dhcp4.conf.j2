// Kea DHCPv4 — rendered by fabricctl (fabric/jinja/kea/kea-dhcp4.conf.j2) from `dhcp:` in vars.yaml.
{% set d = dhcp | default({}) %}
{% set ddns_zone = (d.ddns_subdomain | default('dhcp')) ~ '.' ~ domain %}
{# a reservation whose names are set by hand ("ddns": false: the address manager's published names, or an address a
   record of `dns:` names) is put in the SKIP_DDNS class, and the ddns-tuning hook makes Kea send no DNS update for
   it, forward or reverse: a name set by hand is never replaced by DHCP's (2.1.10.20) #}
{% set skip = namespace(on=false) %}
{% for s in d.subnets | default([]) %}{% for r in s.reservations | default([]) %}{% if d.ddns | default(true) and r.ddns is defined and not r.ddns %}{% set skip.on = true %}{% endif %}{% endfor %}{% endfor %}
{% set classes = kea_client_classes(d.client_classes) if d.client_classes | default([]) else [] %}
{% if skip.on and 'SKIP_DDNS' not in classes | map(attribute='name') | list %}
{% set _ = classes.append({"name": "SKIP_DDNS"}) %}
{% endif %}
{
"Dhcp4": {
    "interfaces-config": {
        "interfaces": {{ d.interfaces | default([]) | to_json }},
        "dhcp-socket-type": "raw"
    },
    "control-socket": { "socket-type": "unix", "socket-name": "/var/run/kea/kea4-ctrl-socket" },
    "lease-database": { "type": "memfile", "persist": true, "name": "/var/lib/kea/kea-leases4.csv", "lfc-interval": 3600 },
    "hooks-libraries": [
        { "library": "libdhcp_lease_cmds.so" },
{% if skip.on %}
        // the hook refuses to load without a parameters map, which `kea-dhcp4 -t` does not catch
        { "library": "libdhcp_ddns_tuning.so", "parameters": {} },
{% endif %}
        { "library": "libdhcp_stat_cmds.so" }
    ],
    "valid-lifetime": {{ d.lease_time | default(86400) }},
    "renew-timer": {{ ((d.lease_time | default(86400)) / 2) | int }},
    "rebind-timer": {{ ((d.lease_time | default(86400)) * 7 / 8) | int }},
{% if d.ddns | default(true) %}
    // hostnames of leases go to their own dynamic zone, never a zone fabric renders (design 2.1.4.1)
    "dhcp-ddns": { "enable-updates": true, "server-ip": "{{ ip_kea_ddns }}", "server-port": 53001 },
    "ddns-send-updates": true,
    "ddns-qualifying-suffix": "{{ ddns_zone }}.",
    "ddns-override-client-update": true,
    "ddns-replace-client-name": "when-not-present",
    "ddns-generated-prefix": "dhcp",
    "ddns-conflict-resolution-mode": "check-with-dhcid",
    // a renewal registers again: what BIND lost while down comes back (2.1.10.7); lease caching would reuse a
    // recent lease without any update, so it is off (one lease-file write per renewal)
    "ddns-update-on-renew": true,
    "cache-threshold": 0.0,
    "hostname-char-set": "[^A-Za-z0-9.-]",
    "hostname-char-replacement": "-",
{% endif %}
{# fabric's own options (DNS, time, domain, search list); the admin's dhcp.options replace them by name and add
   any others (manual 1.10.2) #}
{% set fabric_options = [{"name": "domain-name-servers", "data": (d.dns | default([host_ip])) | join(', ')}] %}
{% if (d.ntp is defined or ntp_serve | default(true)) and (d.ntp | default([host_ip])) %}
{% set _ = fabric_options.append({"name": "ntp-servers", "data": (d.ntp | default([host_ip])) | join(', ')}) %}
{% endif %}
{% set _ = fabric_options.append({"name": "domain-name", "data": d.domain | default(domain)}) %}
{% set _ = fabric_options.append({"name": "domain-search", "data": (([ddns_zone] if d.ddns | default(true) else []) + [domain]) | join(', ')}) %}
    "option-data": {{ kea_option_data(fabric_options, d.options) | to_json }},
{% if d.option_defs | default([]) %}
    "option-def": {{ kea_option_defs(d.option_defs) | to_json }},
{% endif %}
{% if classes %}
    "client-classes": {{ classes | to_json }},
{% endif %}
    "subnet4": [
{% for s in d.subnets | default([]) %}
        {
            "id": {{ s.id | default(loop.index) }},
            "subnet": "{{ s.subnet }}",
{% set uc = {} %}
{% for k in ['name', 'vlan', 'notes'] if s[k] is defined %}{% set _ = uc.update({k: s[k]}) %}{% endfor %}
{% if uc %}
            "user-context": {{ uc | to_json }},
{% endif %}
{% if s.relay is defined and s.relay %}
            "relay": { "ip-addresses": [ "{{ s.relay }}" ] },
{% endif %}
            "pools": [ {% for p in s.pools | default([]) %}{ "pool": "{{ p }}" }{{ ', ' if not loop.last }}{% endfor %} ],
{# the subnet's own DNS and time server: fabric's address on the interface that serves it (2.1.10.5), unless
   dhcp.dns / dhcp.ntp or a global option names them; the subnet's own options still replace these #}
{% set _global_names = d.options | default([]) | selectattr('name', 'defined') | map(attribute='name') | list %}
{% set sub_defaults = [{"name": "routers", "data": s.routers}] if s.routers is defined and s.routers else [] %}
{% if s.server is defined and s.server and s.server != host_ip %}
{# fabric's names point to host_ip: give the subnet a route to it through fabric's address there (option 121); a
   client given option 121 ignores the router option (RFC 3442), so the default route goes in too (manual 1.10.3.3) #}
{% set _routes = [host_ip ~ "/32 - " ~ s.server] + (["0.0.0.0/0 - " ~ s.routers] if s.routers is defined and s.routers else []) %}
{% set _ = sub_defaults.append({"name": "classless-static-route", "data": _routes | join(", ")}) %}
{% if d.dns is not defined and 'domain-name-servers' not in _global_names %}
{% set _ = sub_defaults.append({"name": "domain-name-servers", "data": s.server}) %}
{% endif %}
{% if d.ntp is not defined and ntp_serve | default(true) and 'ntp-servers' not in _global_names %}
{% set _ = sub_defaults.append({"name": "ntp-servers", "data": s.server}) %}
{% endif %}
{% endif %}
            "option-data": {{ kea_option_data(sub_defaults, s.options) | to_json }},
            "reservations": [
{% for r in s.reservations | default([]) %}
                { "hw-address": "{{ r.mac | lower }}", "ip-address": "{{ r.ip }}"{% if r.hostname is defined and r.hostname %}, "hostname": "{{ r.hostname }}"{% endif %}{% if r.options is defined and r.options %}, "option-data": {{ kea_option_data([], r.options) | to_json }}{% endif %}{% if skip.on and r.ddns is defined and not r.ddns %}, "client-classes": [ "SKIP_DDNS" ]{% endif %} }{{ ',' if not loop.last }}
{% endfor %}
            ]
        }{{ ',' if not loop.last }}
{% endfor %}
    ],
    "loggers": [ { "name": "kea-dhcp4", "output-options": [ { "output": "stdout" } ], "severity": "INFO" } ]
}
}
