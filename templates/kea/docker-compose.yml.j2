services:
  # DHCPv4 needs the LAN interface itself (broadcast), so it runs in the host
  # network with exactly two capabilities: raw sockets (answering clients that
  # have no address yet) and port 67. A documented exception to "no
  # capabilities, non-root": Kea cannot drop to another user, so it runs as
  # root inside the container, with a read-only root and no-new-privileges.
  kea-dhcp4:
{% set published = published_ref('kea') %}
    # fabric's published image when this host can use it, else its own build (manual 1.14.3.3)
    image: {{ published or image_kea }}
{% if not published %}
    build:
      context: {{ deploy_base_dir }}/kea/build
      args:
        BASE_IMAGE: "{{ image_debian }}"
        KEA_VERSION: "{{ packages_lock.kea.version }}"
        KEA_REPO: "{{ packages_lock.kea.repo }}"
        KEA_SUITE: "{{ packages_lock.kea.suite }}"
        KEA_KEY_URL: "{{ packages_lock.kea.key_url }}"
        KEA_KEY_FINGERPRINT: "{{ packages_lock.kea.key_fingerprint }}"
        KEA_UID: "{{ service_users.kea.uid }}"
        KEA_GID: "{{ service_users.kea.gid }}"
{% endif %}
    container_name: kea-dhcp4
    logging:
      driver: journald
      options:
        tag: "{{ '{{.Name}}' }}"
    # The run folder is shared with the host (the control socket) and so
    # outlives the container: a PID file left by the previous container names
    # the same PID, and Kea would refuse to start ("already running").
    command: ["sh", "-c", "rm -f /run/kea/*.pid && exec /usr/sbin/kea-dhcp4 -c /config/kea-dhcp4.conf"]
    network_mode: host
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - NET_RAW
      - NET_BIND_SERVICE
    tmpfs:
      - /tmp:noexec,nosuid,size=8m
    volumes:
      - {{ deploy_base_dir }}/kea/config:/config:ro
      - {{ deploy_base_dir }}/kea/leases:/var/lib/kea
      - {{ deploy_base_dir }}/kea/run:/run/kea
    mem_limit: {{ memory_mb('kea') }}m
    healthcheck:
      test: ["CMD", "test", "-S", "/var/run/kea/kea4-ctrl-socket"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s
{% if (dhcp | default({})).ddns | default(true) %}

  # DHCP-DDNS: registers lease hostnames in dhcp.<domain> with its own TSIG key.
  kea-ddns:
    image: {{ published or image_kea }}
    container_name: kea-ddns
    depends_on:
      - kea-dhcp4
    logging:
      driver: journald
      options:
        tag: "{{ '{{.Name}}' }}"
    # Its run folder is shared with the host too (the control socket: an apply reloads a changed file over it,
    # 2.1.10.45), so a PID file left by the previous container is removed first, as for kea-dhcp4.
    command: ["sh", "-c", "rm -f /run/kea/*.pid && exec /usr/sbin/kea-dhcp-ddns -c /config/kea-dhcp-ddns.conf"]
    user: "{{ service_users.kea.uid }}:{{ service_users.kea.gid }}"
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    tmpfs:
      - /tmp:noexec,nosuid,size=8m
    volumes:
      - {{ deploy_base_dir }}/kea/config:/config:ro
      - {{ deploy_base_dir }}/kea/run-ddns:/run/kea
    networks:
      fabric_net:
        ipv4_address: "{{ ip_kea_ddns }}"
    mem_limit: {{ memory_mb('kea') }}m
    healthcheck:
      test: ["CMD", "test", "-S", "/var/run/kea/kea-ddns-ctrl-socket"]
      interval: 30s
      timeout: 5s
      retries: 3

networks:
  fabric_net:
    name: fabric_net
    external: true
{% endif %}
