# The RADIUS server switches and access points talk to.
server fabric {
	listen {
		type = auth
		ipaddr = *
		port = 1812
	}
	listen {
		type = acct
		ipaddr = *
		port = 1813
	}

	authorize {
		# the client that asked, for the policy's vendor rules and the log (manual 1.11.1.2)
		update request {
			&Tmp-String-3 := "%{client:shortname}"
		}
		# EAP (802.1X): the eap module drives the exchange; the device check
		# runs in fabric-check-eap-tls once the certificate is verified.
		eap {
			ok = return
		}
		# Anything else is MAB (MAC authentication bypass): fabric_policy
		# accepts only a device whose roles grant network:mab.
		fabric_policy
	}

	authenticate {
		eap
	}

	# Accounting: logged by the policy as one `fabric: ACCT` line (the sessions
	# the console lists, 1.11.1.4), then acknowledged; nothing else is stored.
	accounting {
		update request {
			&Tmp-String-3 := "%{client:shortname}"
		}
		fabric_policy
		ok
	}

	post-auth {
		Post-Auth-Type REJECT {
			eap
		}
	}
}
