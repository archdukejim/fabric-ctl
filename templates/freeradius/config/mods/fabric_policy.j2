# fabric's 802.1X policy (fabric/jinja/freeradius/python): looks the device up
# in the site's DC (AD) by certificate fingerprint (EAP-TLS) or MAC (MAB), refuses
# disabled devices and devices whose roles lack the permission, and returns
# the VLAN of the lowest-priority role that sets one.
python3 fabric_policy {
	python_path = "/etc/freeradius/python:/usr/lib/python3/dist-packages"
	module = fabric_radius
	mod_instantiate = ${.module}
	func_instantiate = instantiate
	mod_authorize = ${.module}
	func_authorize = authorize
	mod_post_auth = ${.module}
	func_post_auth = post_auth
	# accounting: one `fabric: ACCT` line per request, the sessions the console lists (1.11.1.4)
	mod_accounting = ${.module}
	func_accounting = accounting
}
