services:
  # 802.1X (design §6): switches and access points ask here; fabric's policy
  # answers from the site's DC (AD, LDAPS to the host's address). Non-root, no capabilities, read-only.
  freeradius:
{% set published = published_ref('freeradius') %}
    # fabric's published image when this host can use it, else its own build (manual 1.14.3.3)
    image: {{ published or image_freeradius }}
{% if not published %}
    build:
      context: {{ deploy_base_dir }}/freeradius/build
      args:
        BASE_IMAGE: "{{ image_debian }}"
        RADIUS_UID: "{{ service_users.freeradius.uid }}"
        RADIUS_GID: "{{ service_users.freeradius.gid }}"
{% endif %}
    container_name: freeradius
    user: "{{ service_users.freeradius.uid }}:{{ service_users.freeradius.gid }}"
    logging:
      driver: journald
      options:
        tag: "{{ '{{.Name}}' }}"
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    tmpfs:
      - /tmp:noexec,nosuid,size=8m
      # PID file, the fingerprint cache and the certificate files EAP-TLS writes while verifying
      - /run/freeradius:uid={{ service_users.freeradius.uid }},gid={{ service_users.freeradius.gid }},mode=0700,size=8m
    volumes:
      - {{ deploy_base_dir }}/freeradius/config:/etc/freeradius/fabric:ro
      - {{ deploy_base_dir }}/freeradius/certs:/etc/freeradius/certs:ro
      - {{ deploy_base_dir }}/freeradius/python:/etc/freeradius/python:ro
      # PEAP: ntlm_auth asks the site's DC through its winbind — its sockets, its privileged pipe (FreeRADIUS's
      # group only) and its smb.conf, all read-only
      - {{ deploy_base_dir }}/samba/winbindd:/run/samba/winbindd:ro
      - {{ deploy_base_dir }}/samba/data/state/winbindd_privileged:/data/state/winbindd_privileged:ro
      - {{ deploy_base_dir }}/samba/data/etc:/etc/samba:ro
    ports:
      - "{{ host_ip }}:1812:1812/udp"
      - "{{ host_ip }}:1813:1813/udp"
    networks:
      fabric_net:
        ipv4_address: "{{ ip_freeradius }}"
    mem_limit: {{ memory_mb('freeradius') }}m
    healthcheck:
      test: ["CMD", "sh", "-c", "kill -0 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

networks:
  fabric_net:
    name: fabric_net
    external: true
