[Unit]
Description=fabric: this fabric host's own management, as its account's fabric-managed membership says (manual 1.6.11.11)
After=docker.service fabric.target sssd.service
Wants=docker.service

[Service]
Type=oneshot
# skipped, not failed, while setup is working or fabric is stopped: what it needs may not be there yet
# (2.3.1.32 finding 18; exit 1 of the condition is "skipped")
ExecCondition=/bin/sh -c '! systemctl is-active --quiet fabric-setup.service && systemctl is-active --quiet fabric.target'
ExecStart=/usr/bin/fabricctl domain host-managed --scheduled
