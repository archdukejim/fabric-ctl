[Unit]
Description=fabric: rotate Keycloak's database password (manual 1.7.1, decision 2.1.7.4)
After=docker.service fabric.target openbao.service
Wants=docker.service

[Service]
Type=oneshot
# skipped, not failed, while setup is working or fabric is stopped: what it needs may not be there yet
# (2.3.1.32 finding 18; exit 1 of the condition is "skipped")
ExecCondition=/bin/sh -c '! systemctl is-active --quiet fabric-setup.service && systemctl is-active --quiet fabric.target'
# OpenBao sets a new password in Postgres; fabric keeps it, applies Keycloak's settings and waits until it is healthy.
# A failure leaves Keycloak's open connections working and is recorded for doctor
ExecStart=/usr/bin/fabricctl vault rotate-db --scheduled
