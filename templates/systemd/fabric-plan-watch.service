[Unit]
Description=fabric: the address plan poll: Kea re-rendered when the plan changed (manual 1.10.4.26, 2.1.10.24)
After=docker.service fabric.target
Wants=docker.service

[Service]
Type=oneshot
# skipped, not failed, while setup is working or fabric is stopped: what it needs may not be there yet
# (2.3.1.32 finding 18; exit 1 of the condition is "skipped")
ExecCondition=/bin/sh -c '! systemctl is-active --quiet fabric-setup.service && systemctl is-active --quiet fabric.target'
# Kea alone, never a full apply; a failure fails the run (systemctl status fabric-plan-watch) and the next run retries
ExecStart=/usr/bin/fabricctl ipam watch --scheduled
