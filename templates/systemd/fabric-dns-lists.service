[Unit]
Description=fabric: fetch a copy of every DNS filter list; AdGuard Home rereads the changed ones (manual 1.12.3.5)
After=docker.service fabric.target network-online.target
Wants=docker.service network-online.target

[Service]
Type=oneshot
# skipped, not failed, while setup is working or fabric is stopped: what it needs may not be there yet
# (2.3.1.32 finding 18; exit 1 of the condition is "skipped")
ExecCondition=/bin/sh -c '! systemctl is-active --quiet fabric-setup.service && systemctl is-active --quiet fabric.target'
# a list that cannot be fetched keeps its last good copy; its state says why (fabricctl dns-filter status)
ExecStart=/usr/bin/fabricctl dns-filter lists --scheduled
