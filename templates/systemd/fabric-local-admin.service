[Unit]
Description=fabric: this host's local-admin: a use seen in the journal and wtmp, its rotation after use, SSH applied (manual 1.7.1.4)
After=docker.service fabric.target
Wants=docker.service

[Service]
Type=oneshot
# skipped, not failed, while setup is working or fabric is stopped: what it needs may not be there yet
# (2.3.1.32 finding 18; exit 1 of the condition is "skipped")
ExecCondition=/bin/sh -c '! systemctl is-active --quiet fabric-setup.service && systemctl is-active --quiet fabric.target'
ExecStart=/usr/bin/fabricctl local-admin check --scheduled
