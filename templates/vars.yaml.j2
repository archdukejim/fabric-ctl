---
# ============================================================
# RESOLVED VARS — auto-generated by 01-render-jinja.yml
# Sources: /custom-vars.yaml
#
# Do not edit directly — regenerated on every run of 01-render-jinja.yml.
# To change settings edit the source files above.
# ============================================================

# ============================================================
# GLOBAL
# ============================================================
domain: {{ domain }}
domain_file: {{ domain_file | default(domain | replace('.', '_')) }}
hostname: {{ hostname }}
{# free text (organisation labels): written as JSON strings, valid YAML whatever they hold (manual 1.1.5.7) #}
friendly_name: {{ (friendly_name | default("Example Org", true)) | to_json }}
service_mark: {{ (service_mark | default(none, true)) | to_json }}
care_of: {{ (care_of | default(none, true)) | to_json }}
trademark: {{ (trademark | default(none, true)) | to_json }}
copyright: {{ (copyright | default(none, true)) | to_json }}
contact_email: {{ (contact_email | default(none, true)) | to_json }}
contact_phone: {{ (contact_phone | default(none, true)) | to_json }}
address_line1: {{ (address_line1 | default(none, true)) | to_json }}
address_line2: {{ (address_line2 | default(none, true)) | to_json }}
system_timezone: {{ system_timezone | default('America/New_York') }}
deploy_base_dir: {{ deploy_base_dir | default('/opt') }}

# ============================================================
# NETWORK
# ============================================================
lan_cidr: {{ lan_cidr }}
lan_gateway: {{ lan_gateway }}
dns_server: {{ dns_server | default('8.8.8.8') }}
use_host_dns: {{ use_host_dns | default(true) | lower }}
fabric_subnet: {{ fabric_subnet | default('10.255.0.0/24') }}
host_ip: {{ host_ip }}

# ============================================================
# SERVICE IPs
# ============================================================
# the host's own address on fabric_net: the services on the host network (the DC) answer containers here, so their
# traffic stays on the bridge (2.1.2.15)
ip_fabric_gateway: {{ ip_fabric_gateway | default('10.255.0.1') }}
ip_nginx: {{ ip_nginx | default('10.255.0.10') }}
ip_bind9: {{ ip_bind9 | default('10.255.0.30') }}
ip_stepca: {{ ip_stepca | default('10.255.0.40') }}
ip_keycloak: {{ ip_keycloak | default('10.255.0.60') }}
ip_postgres: {{ ip_postgres | default('10.255.0.70') }}
ip_webui: {{ ip_webui | default('10.255.0.80') }}
ip_openbao: {{ ip_openbao | default('10.255.0.90') }}

# ============================================================
# SERVICE HOSTNAMES
# ============================================================
cname_ca: {{ cname_ca | default('ca') }}
# The landing page's alias (2.1.4.6, manual 1.4.2.5): the install's first render adds <landing_page_cname>.<domain>
# (info by default) as an ordinary record, which the admin may rename, repoint or delete; the page itself is at
# http://<host_ip>/info/ and on <domain>, the host's own name and hostname_landing.
landing_page_cname: {{ landing_page_cname | default('info', true) }}
cname_dns: {{ cname_dns | default('dns') }}
cname_sso: {{ cname_sso | default('sso') }}
cname_mgr: {{ cname_mgr | default('fabric-ctl') }}
cname_openbao: {{ cname_openbao | default('vault') }}
{# The web UI's address: any host name (default fabric-ctl.<domain> on a new install, 2.1.8.12; an install's own
   cname_mgr is kept in its vars.yaml, so an upgrade keeps its address). Outside the
   domain, fabric issues its certificate but you point DNS at this host. #}
webui_hostname: {{ webui_hostname | default('', true) }}

hostname_nginx: {{ hostname_nginx | default('nginx.' ~ domain) }}
hostname_bind9: {{ hostname_bind9 | default((cname_dns | default('dns')) ~ '.' ~ domain) }}
hostname_stepca: {{ hostname_stepca | default((cname_ca | default('ca')) ~ '.' ~ domain) }}
hostname_landing: {{ hostname_landing | default((landing_page_cname | default('info', true)) ~ '.' ~ domain) }}
{# whether this install has once been ready (setup's last step sets it, 2.1.4.10): until then every render adds the
   landing page's alias, so a failed first install run again keeps it; an install from before 0.8.0 (hostname_landing
   stored) has been #}
install_was_ready: {{ (install_was_ready | default(hostname_landing is defined)) | lower }}
hostname_keycloak: {{ hostname_keycloak | default((cname_sso | default('sso')) ~ '.' ~ domain) }}
{% set _hostname_mgr = (webui_hostname | default('', true) or ((cname_mgr | default('fabric-ctl')) ~ '.' ~ domain)) | lower %}
hostname_mgr: {{ _hostname_mgr }}
{# CA certificates for every system: http://<hostname_stepca>/certs/ (fabric's texts and scripts, and the CRL point:
   1.5.1.6), http://<host_ip>/certs/, and every other name nginx answers; certs.<domain> was dropped in 0.7.0 (1.5.1.5).
   ca.<domain> over HTTPS is Step-CA's API. #}
hostname_openbao: {{ ((cname_openbao | default('vault')) ~ '.' ~ domain) | lower }}
hostname_radius: {{ ((cname_radius | default('radius')) ~ '.' ~ domain) | lower }}
hostname_ntp: {{ ((cname_ntp | default('ntp')) ~ '.' ~ domain) | lower }}
{# The federation endpoint (manual 1.9.4.2): sites join this install through it. Off until
   `fabricctl federation enable`; the name is always computed. #}
federation_endpoint: {{ federation_endpoint | default(false) | bool | lower }}
hostname_federation: {{ ((cname_federation | default('federation')) ~ '.' ~ domain) | lower }}

# ============================================================
# DOCKER IMAGES
# ============================================================
{# Defaults: the validated images, pinned by digest (fabric/images.lock.yaml). A host keeps
   the images it runs across fabric upgrades; `fabricctl images update` moves it to this list. #}
image_nginx: {{ image_nginx | default(images_lock.nginx) }}
{# stepca and keycloak run thin local layers built FROM these (fabric/jinja/<svc>/build). #}
image_stepca: {{ image_stepca | default(images_lock.stepca) }}
image_keycloak: {{ image_keycloak | default(images_lock.keycloak) }}
image_postgres: {{ image_postgres | default(images_lock.postgres) }}
image_openbao: {{ image_openbao | default(images_lock.openbao) }}
image_fluentbit: {{ image_fluentbit | default(images_lock.fluentbit) }}
image_adguard: {{ image_adguard | default(images_lock.adguard) }}
{# Base of the locally built images (Debian packages). #}
image_debian: {{ image_debian | default(images_lock.debian) }}
{# Names of the locally built images (not pulled). #}
image_webui: {{ image_webui | default('fabric/web:local') }}
image_kea: {{ image_kea | default('fabric/kea:local') }}
image_freeradius: {{ image_freeradius | default('fabric/freeradius:local') }}
image_samba: {{ image_samba | default('fabric/samba:local') }}
{# fabric's own images as published (manual 1.14.3): "" until the lock pins a digest. The compose files run one
   when it is set and the host's ids match it (published_ref); otherwise the host builds that image itself.
   They carry fabric's own code, so they follow the release (as a local build did): always the lock's, unless the
   admin pinned one in image_pins, or `fabricctl images rollback` moved it back (image_rolled_back, which the next
   update clears; 0.6.3 image-update test). #}
{% set _held = (image_pins | default([], true)) + (image_rolled_back | default([], true)) %}
image_fabric_bind9: "{{ image_fabric_bind9 if 'image_fabric_bind9' in _held else published_lock.bind9 }}"
image_fabric_freeradius: "{{ image_fabric_freeradius if 'image_fabric_freeradius' in _held else published_lock.freeradius }}"
image_fabric_kea: "{{ image_fabric_kea if 'image_fabric_kea' in _held else published_lock.kea }}"
image_fabric_keycloak: "{{ image_fabric_keycloak if 'image_fabric_keycloak' in _held else published_lock.keycloak }}"
image_fabric_samba: "{{ image_fabric_samba if 'image_fabric_samba' in _held else published_lock.samba }}"
image_fabric_stepca: "{{ image_fabric_stepca if 'image_fabric_stepca' in _held else published_lock.stepca }}"
image_fabric_webui: "{{ image_fabric_webui if 'image_fabric_webui' in _held else published_lock.webui }}"
{# verifies their signatures before a new digest is used (2.1.14.6, 2.1.14.11) #}
image_cosign: {{ image_cosign | default(images_lock.cosign) }}
{# false turns the signature check off (2.1.14.10): a relaxation, listed by `fabricctl status` and the web UI #}
image_signature_check: {{ image_signature_check | default(true) | bool }}
{# image_* keys the admin set explicitly: `fabricctl images update` leaves them alone. #}
image_pins: {{ image_pins | default([], true) | to_json }}
image_rolled_back: {{ image_rolled_back | default([], true) | to_json }}
# After `fabricctl images update`: remove old images of fabric's repositories (never the rollback one).
image_prune: {{ image_prune | default(true) | bool }}

# OpenBao (secrets) is core. Its unlock methods (slots.json) and their key files / token PINs, root-only.
openbao_key_dir: {{ openbao_key_dir | default('/etc/fabric/openbao') }}
# RAM-only: fabric-unlock puts the vault key here just before OpenBao starts, then wipes it.
openbao_runtime_dir: {{ openbao_runtime_dir | default('/run/fabric/openbao') }}
# RAM-only: OpenBao's break-glass socket (generate-root), root and the openbao user only.
openbao_admin_dir: {{ openbao_admin_dir | default('/run/fabric/openbao-admin') }}
openbao_seal_key_id: {{ openbao_seal_key_id | default('fabric-1') }}
{# Memory as a budget (manual 1.2.4.3, 2.1.1.47): every installed service's limit, planned here from host_ram_capacity,
   the parts that are on and memory_floors / memory_weights. A `*_mem_limit` below is kept only when the admin set it
   (its pre-0.9 default counts as not set): it fixes that service's limit. #}
{% set _mem = plan_memory({
  'host_ram_capacity': host_ram_capacity | default(host_ram_detected | default(4), true) | int,
  'install_keycloak': install_keycloak | default(false) | bool,
  'install_webui': (install_webui | default(true) | bool) and (install_keycloak | default(false) | bool),
  'install_kea': install_kea | default(false) | bool,
  'install_freeradius': install_freeradius | default(false) | bool,
  'install_fluentbit': install_fluentbit | default(false) | bool,
  'dns_filter': dns_filter | default('bind', true) | lower,
  'memory_floors': memory_floors | default({}, true), 'memory_weights': memory_weights | default({}, true),
  'openbao_mem_limit': openbao_mem_limit | default(none), 'kea_mem_limit': kea_mem_limit | default(none),
  'samba_mem_limit': samba_mem_limit | default(none), 'freeradius_mem_limit': freeradius_mem_limit | default(none),
  'fluentbit_mem_limit': fluentbit_mem_limit | default(none), 'resolver_mem_limit': resolver_mem_limit | default(none),
  'adguard_mem_limit': adguard_mem_limit | default(none),
}) %}
openbao_mem_limit: {{ _mem.settings.openbao_mem_limit | to_json }}
# PKCS#11 libraries fabric may load for security-key unlock methods (paths or globs; they run as root).
# Empty: ykcs11 (YubiKey), OpenSC and SoftHSM2 at their Debian/Ubuntu paths.
openbao_pkcs11_modules: {{ openbao_pkcs11_modules | default([], true) | to_json }}
# Recovery keys shown once at init (needed for a new root token or a seal migration).
openbao_recovery_shares: {{ openbao_recovery_shares | default(1) }}
openbao_recovery_threshold: {{ openbao_recovery_threshold | default(1) }}
install_keycloak: {{ install_keycloak | default(false) | bool }}
# Log forwarding (optional, design 2.1.15.1): Fluent Bit sends the host journal (all fabric
# containers and fabric's audit log) and OpenBao's audit log to syslog and/or Elasticsearch.
install_fluentbit: {{ install_fluentbit | default(false) | bool }}
# DHCP (optional, design §5): Kea 3.0 LTS on the host network; lease hostnames go
# to their own dynamic zone <ddns_subdomain>.<domain> (2.1.4.1).
install_kea: {{ install_kea | default(false) | bool }}
ip_kea_ddns: {{ ip_kea_ddns | default('10.255.0.97') }}
kea_mem_limit: {{ _mem.settings.kea_mem_limit | to_json }}
# interfaces: host interfaces to serve; subnets: [{subnet, pools: ["a - b"], routers,
# reservations: [{mac, ip, hostname}]}]; ddns (true), ddns_subdomain (dhcp), lease_time (s), dns
dhcp: {{ dhcp | default({}, true) | to_json }}
# The directory (manual 1.6.3, 1.6.5): a Samba AD domain controller on the host's address, on every install. The
# domain is chosen once and is permanent (2.1.6.11); the password policy is the admin's, with no defaults (2.1.6.13):
# setup asks both, and check_settings refuses an install without them.
{% set _ad = (ad_domain | default('', true)) | lower %}
ad_domain: "{{ _ad }}"
ad_realm: "{{ _ad | upper }}"
ad_base_dn: "{{ _ad.split('.') | map('regex_replace', '^', 'DC=') | join(',') if _ad else '' }}"
ad_netbios: "{{ (ad_netbios | default(_ad.split('.')[0], true))[:15] | upper }}"
{# the DC's own name in the domain (2.1.6.45, 2.1.6.65, manual 1.6.5.26), apart from the host's: fabric names it,
   never a person (dc-0001 for a new domain, the upstream's choice for a joining site); permanent. #}
{% set _dc = (dc_name | default('dc-0001', true)) | lower %}
dc_name: "{{ _dc }}"
hostname_dc: "{{ (_dc ~ '.' ~ _ad) | lower if _ad else '' }}"
# minimum_length, complexity (bool), history, minimum_age_days, maximum_age_days, lockout_threshold,
# lockout_minutes, lockout_window_minutes: every key required
ad_password_policy: {{ ad_password_policy | default({}, true) | to_json }}
{# the tiers' own password policies (2.1.6.71), set only on the host: fabric-admin's and the Directory Administrators',
   each an AD fine-grained password policy; setup starts them as copies of the default (fabric-admin: 3, then 15 minutes) #}
ad_tier_password_policies: {{ ad_tier_password_policies | default({}, true) | to_json }}
{# the domain's Kerberos ticket policy (manual 1.6.12.9): ticket_hours, renew_days, skew_minutes; AD's defaults #}
ad_kerberos_policy: {{ ad_kerberos_policy | default({'ticket_hours': 10, 'renew_days': 7, 'skew_minutes': 5}, true) | to_json }}
{# a machine no grant reaches: false (default) admits nobody from the domain, the fallback GPO `fabric: access none`
   (2.1.6.87); true, a relaxation, leaves it open to every domain person, sssd's and Windows' own default (2.1.6.88) #}
grants_fallback_open: {{ grants_fallback_open | default(false) | bool }}
ad_old_password_minutes: {{ ad_old_password_minutes | default(0) | int }}
{# the DC's signing socket for Windows members' time (2.1.13.1), where the host's chrony reaches it: the one path
   Ubuntu's AppArmor profile for chronyd allows (manual 1.6.5.8) #}
ad_ntp_signd_dir: {{ ad_ntp_signd_dir | default('/var/lib/samba/ntp_signd', true) }}
ad_rpc_ports: "{{ ad_rpc_ports | default('49152-49251', true) }}"
{# A site's DC (manual 1.8.8.3-1.8.8.4): writable or read-only; the root's is always writable. A site joining the root's
   domain gets from the join the root DC's address and name (setup's join step writes them). Its id range is its
   name's (dc-NNNN: N x 1000000, 2.1.6.63, 2.1.6.86): no setting. #}
ad_dc_type: {{ ad_dc_type | default('writable', true) }}
ad_join_server: "{{ ad_join_server | default('', true) }}"
ad_join_server_name: "{{ ad_join_server_name | default('', true) }}"
# This host as a member of its own domain (manual 1.6.11.8, 2.1.6.34): no domain account signs in to it (a host that
# runs a DC is the top tier, 2.1.6.75); local accounts are untouched. Asked in setup's Advanced; false leaves the host
# out (status shows it).
host_join_domain: {{ host_join_domain | default(true) | to_json }}
# After how many days sssd renews this host's machine password with adcli (manual 1.6.11.12, 2.1.6.50): 0 never (the
# default: the password is set once); a whole number from 1 to 999 turns it on (setup's member step installs adcli).
host_machine_password_renew_days: {{ host_machine_password_renew_days | default(0) | to_json }}
samba_mem_limit: {{ _mem.settings.samba_mem_limit | to_json }}
# 802.1X (optional, design §6): FreeRADIUS 3.2 checks each device against the site's DC
# (EAP-TLS by linked certificate, MAB by MAC) and returns its role's VLAN.
install_freeradius: {{ install_freeradius | default(false) | bool }}
ip_freeradius: {{ ip_freeradius | default('10.255.0.98') }}
freeradius_mem_limit: {{ _mem.settings.freeradius_mem_limit | to_json }}
# The switches and access points that ask: [{name, address (IP or CIDR), message_authenticator (true)}].
# Each one's shared secret is generated and kept in OpenBao (fabricctl secrets show radius_secrets).
radius_clients: {{ radius_clients | default([], true) | to_json }}
# People who may join by password (EAP-TTLS): members of these directory groups only,
# [{group, vlan (optional), priority (100; lower wins)}]. Empty: no password logins.
# Default: the two network groups (empty at first), no VLAN yet; an empty list stays empty.
radius_people: {{ radius_people | default([{'group': 'network-staff', 'vlan': none, 'priority': 50},
                                          {'group': 'network-guests', 'vlan': none, 'priority': 100}]) | to_json }}
ip_fluentbit: {{ ip_fluentbit | default('10.255.0.95') }}
fluentbit_mem_limit: {{ _mem.settings.fluentbit_mem_limit | to_json }}
# DNS filter (manual 1.12.2, 1.12.3; on by default, 2.1.12.3): a BIND resolver answers clients on host_ip:53 (the
# owner's rules, safe search, groups); AdGuard Home behind it matches the lists (2.1.12.6); BIND moves to
# bind_dns_port (5053); fabric's zones go to it, never filtered. none turns it off.
dns_filter: {{ dns_filter | default('bind', true) | lower }}
install_resolver: {{ (dns_filter | default('bind', true) | lower) == 'bind' }}
ip_resolver: {{ ip_resolver | default('10.255.0.33') }}
resolver_mem_limit: {{ _mem.settings.resolver_mem_limit | to_json }}
# AdGuard Home behind the resolver (manual 1.12.3): on fabric_net only, driven through its API by fabric.
# Its memory is planned with the others (1.2.4.3, 2.1.12.8): the budget counts its lists' steady size, and its limit is
# 2.5 times that so compiling them fits (the owner's 16 lists: 380 MiB steady, 751 MiB at their peak); set, the
# limit is fixed and the budget counts it / 2.5.
ip_adguard: {{ ip_adguard | default('10.255.0.34') }}
adguard_mem_limit: {{ _mem.settings.adguard_mem_limit | to_json }}
# Lists [{name, url, enabled}] (hosts, domains or AdGuard syntax), every one kept fetched; [] = none.
# Default: AdGuard's DNS filter.
dns_filter_lists: {{ (dns_filter_lists if dns_filter_lists is defined and dns_filter_lists is not none else [{'name': 'AdGuard DNS filter', 'url': 'https://adguardteam.github.io/HostlistsRegistry/assets/filter_1.txt', 'enabled': true}]) | to_json }}
# Names allowed past every list / blocked whatever the lists say; each with every name below it.
dns_filter_allow: {{ dns_filter_allow | default([], true) | to_json }}
dns_filter_block: {{ dns_filter_block | default([], true) | to_json }}
# AdGuard Home forwards to these over DNS-over-TLS, to each address, its certificate verified for it; at least one.
dns_filter_upstreams: {{ (dns_filter_upstreams if dns_filter_upstreams is defined and dns_filter_upstreams is not none else [{'address': '1.1.1.1', 'name': 'cloudflare-dns.com'}, {'address': '1.0.0.1', 'name': 'cloudflare-dns.com'}]) | to_json }}
# Strict safe search for everyone (Google, YouTube, Bing, DuckDuckGo, Yandex, Pixabay, Ecosia); YouTube strict or moderate.
dns_filter_safe_search: {{ dns_filter_safe_search | default(false) | to_json }}
dns_filter_youtube: {{ dns_filter_youtube | default('strict', true) }}
# Client groups (manual 1.12.2.15, 1.12.3.6): [{name, clients: [addresses, subnets], safe_search, youtube, allow,
# block}]; a group only adds to everyone's rules (the lists are the site's). The most specific address wins.
dns_filter_groups: {{ dns_filter_groups | default([], true) | to_json }}
# Time (manual 1.13.1): chrony on the host keeps its clock and serves the network. ntp_servers: "<host> [nts]
# [pool] [prefer]" (nts: authenticated time); a federated site asks its upstream site first. [] = the upstream
# site only (or this host's own clock). ntp_serve: answer the LAN (UDP 123; Kea hands it out as option 42).
# ntp_set_clock: false runs chrony without setting the clock (a container sharing its host's kernel clock).
ntp_servers: {{ (ntp_servers if ntp_servers is defined and ntp_servers is not none else ['time.cloudflare.com nts', 'nts.netnod.se nts', 'ptbtime1.ptb.de nts']) | to_json }}
ntp_serve: {{ ntp_serve | default(true) | bool | lower }}
ntp_set_clock: {{ ntp_set_clock | default(true) | bool | lower }}
# syslog: {host, port (6514), tls (true), ca_file}; elastic: {url, index, user, ca_file}.
# The Elasticsearch password lives in OpenBao: sudo fabricctl logs set-password elastic
log_forwarding: {{ log_forwarding | default({}, true) | to_json }}
# Web management UI (Keycloak OIDC; a client certificate when webui_client_cert). Requires Keycloak.
install_webui: {{ (install_webui | default(true) | bool) and (install_keycloak | default(false) | bool) }}
webui_realm: {{ webui_realm | default(domain) }}
webui_admin_role: {{ webui_admin_role | default('fabric-console-admin') }}
{# The first Directory Administrator, created by `fabricctl setup` after fabric-admin, the Enterprise Admin (a person in
   the domain + client certificate; 2.1.6.69): user name, full name and e-mail, all required, no default. #}
webui_admin_user: {{ webui_admin_user | default('', true) | to_json }}
webui_admin_first_name: {{ webui_admin_first_name | default('', true) | to_json }}
webui_admin_last_name: {{ webui_admin_last_name | default('', true) | to_json }}
webui_admin_email: {{ webui_admin_email | default('', true) | to_json }}
webui_client_cert_days: {{ webui_client_cert_days | default(365) }}
# Sign-in (manual 2.3.6.2.6.1, 2.1.6.23): a password by default; raised in the web console's Security page, lowered only
# with `sudo fabricctl security lower` (2.1.6.24). Second factors: none | any (TOTP or a passkey) | totp | passkey.
# Kerberos sign-in (the domain logon): off by default, asked at setup (2.1.6.32).
signin_kerberos: {{ signin_kerberos | default(false) | bool | lower }}
signin_admin_second_factor: {{ signin_admin_second_factor | default('none', true) | lower }}
signin_everyone_second_factor: {{ signin_everyone_second_factor | default('none', true) | lower }}
# The web console asks for a client certificate from fabric's CA (2.1.8.2: off by default)
webui_client_cert: {{ webui_client_cert | default(false) | bool | lower }}

# ============================================================
# SECURITY (fabricctl setup; relaxations are shown by fabricctl status)
# ============================================================
{% set _security = {'firewall': true, 'firewall_allow': [], 'docker_daemon_hardening': true} %}
{% set _ = _security.update(security | default({}, true)) %}
security:
{{ _security | to_nice_yaml(indent=2) | indent(2, first=True) }}

# ============================================================
# DOCKER / SERVICE INFRASTRUCTURE
# ============================================================
{# the host's memory in GB (2.1.2.3: 4 at least): the admin's value, else what setup measured (render_vars); every
   container's memory limit follows from it (manual 1.2.4.3) #}
host_ram_capacity: {{ host_ram_capacity | default(host_ram_detected | default(4), true) | int }}
# Each service's memory floor in MB and its weight in what is left (manual 1.2.4.3.2), e.g. {keycloak: 1536} and
# {samba: 4}: services keycloak, samba, resolver, postgres, bind9, nginx, openbao, stepca, webui, kea, freeradius,
# fluentbit. Empty: fabric's own.
memory_floors: {{ memory_floors | default({}, true) | to_json }}
memory_weights: {{ memory_weights | default({}, true) | to_json }}
{# derived on every render, never set: the budget, the reserve and each service's limit (MB) #}
memory_plan: {{ {'capacity_mb': _mem.capacity_mb, 'reserve_mb': _mem.reserve_mb, 'budget_mb': _mem.budget_mb,
                 'limits': _mem.limits, 'containers': _mem.containers, 'explicit': _mem.explicit,
                 'unassigned_mb': _mem.unassigned_mb, 'bursts': _mem.bursts, 'over_mb': _mem.over_mb} | to_json }}
compose_file: {{ compose_file | default((deploy_base_dir | default('/opt')) ~ '/fabric/docker-compose.yml') }}
