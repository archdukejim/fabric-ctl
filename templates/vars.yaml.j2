nginx_backend_stepca: {{ nginx_backend_stepca | default('https://step-ca:' ~ (stepca_port | default(9000))) }}

# ============================================================
# The organisation's name and this site's
# ============================================================
{# The organisation's domain: this install's own domain unless it joined an upstream (manual 1.9), whose organisation it then shares. Names the organisation suffix; fixed once
   installed (setup refuses a change). #}
{% set _org_domain = (org_domain | default(domain, true)) | lower %}
org_domain: {{ _org_domain }}
{# The organisation's base DN: chosen when the root site is installed (e.g. dc=lan), else one dc= per label
   of org_domain; a site gets its upstream's. Fixed once installed (setup refuses a change). #}
{% set _base_dn = ((ldap_base_dn | default('', true)) or (_org_domain.split('.') | map('regex_replace', '^', 'dc=') | join(','))) | lower %}
ldap_base_dn: {{ _base_dn }}
# This install's site (manual 1.9): names its OU in the domain (OU=<site>,OU=sites), which holds its people,
# machines, devices and service accounts. Defaults to the host name; fixed once installed (setup refuses a change).
site_name: {{ (site_name | default(hostname, true)) | lower }}

{# `bundle`: the fabric role bundle Keycloak grants to members (design 2.1.6.1); admins get
   webui_admin_role through webui_admin_group. #}
{# The organisation's groups have fixed gids in the root's built-in range (2.1.6.46, manual 1.6.3.17: 1040001 on,
   the first hundred kept for them). An install from before 0.7.0 keeps 1100-1121 and 5000: its vars list them. #}
{% set default_ldap_groups = [
  { 'gidNumber': 1040001, 'name': 'admins', 'permissions': ['read', 'write', 'modify'] },
  { 'gidNumber': 1040002, 'name': 'auditors', 'bundle': 'fabric-auditor' },
  { 'gidNumber': 1040003, 'name': 'network-operators', 'bundle': 'fabric-network-operator' },
  { 'gidNumber': 1040004, 'name': 'equipment-operators', 'bundle': 'fabric-equipment-operator' },
  { 'gidNumber': 1040005, 'name': 'pki-operators', 'bundle': 'fabric-pki-operator' },
  { 'gidNumber': 1040006, 'name': 'helpdesk', 'bundle': 'fabric-helpdesk' },
  { 'gidNumber': 1040007, 'name': 'network-staff', 'description': 'May join the network by password (802.1X EAP-TTLS)' },
  { 'gidNumber': 1040008, 'name': 'network-guests', 'description': 'May join the network by password (802.1X EAP-TTLS) — map it to a guest VLAN' },
  { 'gidNumber': 1040009, 'name': 'users', 'permissions': ['read'] }
] %}
{% set _merged_groups = (ldap_groups | default([]) + default_ldap_groups) | unique(attribute='name') | list %}
ldap_groups:
{{ _merged_groups | to_nice_yaml(indent=2) | indent(2, first=True) }}

{# People's Linux identities (manual 1.6.6): home folder base and login shell given with the uidNumber #}
posix_home_base: {{ posix_home_base | default('/home') }}
posix_login_shell: {{ posix_login_shell | default('/bin/bash') }}

{% set default_ldap_ous = [
  { 'name': 'accounts', 'description': 'User Accounts' },
  { 'name': 'groups', 'description': 'Security Groups' },
  { 'name': 'users', 'description': 'Regular User accounts', 'parent': 'accounts' },
  { 'name': 'device-roles', 'description': 'What member devices may do (fabric device RBAC)' }
] %}
