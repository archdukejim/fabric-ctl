cert_acme_lifetime_hours: {{ cert_acme_lifetime_hours | default('1128h') }}

# ============================================================
# DNS — BIND9
# ============================================================
{# With the DNS filter on, the BIND resolver answers clients on 53, so BIND can never be there: 53 becomes 5053
   (manual 1.12.2). With it off the port is kept as set (e.g. 5053 behind a resolver of your own). #}
{% set _bind_port = (bind_dns_port | default(53, true)) | int %}
bind_dns_port: {{ 5053 if (dns_filter | default('bind', true) | lower) == 'bind' and _bind_port == 53 else _bind_port }}
bind9_doh_port: {{ bind9_doh_port | default(8053) }}
{% set _fabric_subnet = fabric_subnet | default('10.255.0.0/24') %}
{# DHCP's full subnets resolve through fabric like the LAN (2.1.10.4; guest subnets only through the filter) #}
{% set _dhcp_full = ((dhcp | default({}, true)).subnets | default([], true) | rejectattr('access', 'defined')
                     | map(attribute='subnet') | list) if install_kea | default(false) | bool else [] %}
{% set _dhcp_full = _dhcp_full + (((dhcp | default({}, true)).subnets | default([], true)
                     | selectattr('access', 'defined') | selectattr('access', 'equalto', 'full')
                     | map(attribute='subnet') | list) if install_kea | default(false) | bool else []) %}
{% set default_acls = {
  'acme-updaters': [_fabric_subnet],
  'dns-resolvers': ['127.0.0.1', lan_cidr, _fabric_subnet] + _dhcp_full
} %}
{% set final_bind_acls = default_acls %}
{% if bind_acls is defined %}
{% for k, v in bind_acls.items() %}
{% set filtered_v = [] %}
{% for item in v %}
{% if item == '{{ fabric_subnet }}' %}
{% set _ = filtered_v.append(_fabric_subnet) %}
{% else %}
{% set _ = filtered_v.append(item) %}
{% endif %}
{% endfor %}
{% if k in final_bind_acls %}
{% set _ = final_bind_acls.update({k: (final_bind_acls[k] + filtered_v) | unique | list}) %}
{% else %}
{% set _ = final_bind_acls.update({k: filtered_v}) %}
{% endif %}
{% endfor %}
{% endif %}
bind_acls:
{{ final_bind_acls | to_nice_yaml(indent=2) | indent(2, first=True) }}
{# Update policies inherited by every TSIG key in the ACL (fabricctl acl policy). #}
bind_acl_policies:
{{ bind_acl_policies | default({}, true) | to_nice_yaml(indent=2) | indent(2, first=True) }}
{% set default_cnames = [
  { 'canonical': hostname, 'name': cname_ca | default('ca') },
  { 'canonical': hostname, 'name': cname_dns | default('dns') },
  { 'canonical': hostname, 'name': cname_sso | default('sso') },
  { 'canonical': hostname, 'name': cname_openbao | default('vault') }
] %}
{# The web UI name gets a CNAME only inside this domain, and not when it is the
   host's own name (that already has an A record). #}
{% set _mgr_label = _hostname_mgr[:-(domain | length) - 1] if _hostname_mgr.endswith('.' ~ domain) else '' %}
{% if (install_webui | default(true) | bool) and (install_keycloak | default(false) | bool) and _mgr_label and _mgr_label != hostname %}
{% set _ = default_cnames.append({ 'canonical': hostname, 'name': _mgr_label }) %}
{% endif %}
{% if landing_page_cname | default('info', true) %}
{% set _ = default_cnames.append({ 'canonical': hostname, 'name': landing_page_cname | default('info', true) }) %}
{% endif %}
{% if federation_endpoint | default(false) | bool %}
{% set _ = default_cnames.append({ 'canonical': hostname, 'name': cname_federation | default('federation') }) %}
{% endif %}
{# ntp.<domain> for clients; an install that already has a record of that name keeps its own #}
{% set _own = ((dns | default({})).get('dynamic_zone_var', {}).get('A', []) + (dns | default({})).get('dynamic_zone_var', {}).get('CNAME', [])) | map(attribute='name') | list %}
{% if ntp_serve | default(true) | bool and (cname_ntp | default('ntp')) not in _own %}
{% set _ = default_cnames.append({ 'canonical': hostname, 'name': cname_ntp | default('ntp') }) %}
{% endif %}
{% set default_a = [
  { 'ip': host_ip, 'name': hostname }
] %}
{# <domain> itself answers on this host (it redirects to the info page, 2.1.4.3) unless the admin's own records name it #}
{% if '@' not in _own %}
{% set _ = default_a.append({ 'ip': host_ip, 'name': '@' }) %}
{% endif %}
{% set _user_dns = dns | default({'dynamic_zone_var': {'zone_authority': true}}) %}
{% set _dynamic_zone = _user_dns.get('dynamic_zone_var', {}) %}
{% set _merged_a = (_dynamic_zone.get('A', []) + default_a) | selectattr('name') | rejectattr('name', 'equalto', 'None') | unique | list %}
{% set _merged_cname = (_dynamic_zone.get('CNAME', []) + default_cnames) | selectattr('name') | rejectattr('name', 'equalto', 'None') | unique | list %}
{% set _ = _dynamic_zone.update({'A': _merged_a, 'CNAME': _merged_cname}) %}
{% set _ = _user_dns.update({'dynamic_zone_var': _dynamic_zone}) %}
dns:
{% for zone_key, zone_records in _user_dns.items() %}
  {{ zone_key }}:
{{ zone_records | to_nice_yaml(indent=4) | indent(4, first=True) }}
{% endfor %}
tsig_keys:
{{ tsig_keys | default([]) | to_nice_yaml(indent=2) | indent(2, first=True) }}

