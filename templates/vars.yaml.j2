cert_city: {{ cert_city | default('City') }}
cert_org: {{ cert_org | default(friendly_name) }}
cert_ou: {{ cert_ou | default('IT') }}
# The root CA's lifetime (2.1.5.6), asked in setup's Advanced; the intermediate's is it less a year. Fixed once the
