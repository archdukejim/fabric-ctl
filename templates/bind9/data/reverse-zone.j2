$TTL 86400
$ORIGIN {{ reverse_zone_name }}.

;-----------------------------------------------------------------
; SOA Record
;-----------------------------------------------------------------
@       IN      SOA     ns.{{ domain }}. hostmaster.{{ domain }}. (
                        {{ (lookup('pipe', 'date +%s') | int) + 1000000000 }} ; Serial (Epoch timestamp offset)
                        3600             ; Refresh
                        1800             ; Retry
                        604800           ; Expire
                        30               ; Negative caching TTL (a new lease's or record's name answers within 30 s, 2.1.4.9)
)

;-----------------------------------------------------------------
; NS Records
;-----------------------------------------------------------------
@       IN      NS      ns.{{ domain }}.

;-----------------------------------------------------------------
; PTR Records — generated from the forward zones' A/AAAA records
; (fabriclib/dns/reverse_zones.py): one per address, private ranges only
;-----------------------------------------------------------------
{% for rec in ptr_records %}
{{ "%-23s " | format(rec.label) }}PTR     {{ rec.target }}
{% endfor %}
