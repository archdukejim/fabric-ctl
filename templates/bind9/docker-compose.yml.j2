services:
  bind9:
    # Built from Debian packages on the validated Debian base: bind uid/gid baked
    # in, runs as bind from the first instruction, no capabilities (build/Dockerfile).
{% set published = published_ref('bind9') %}
    # fabric's published image when this host can use it, else its own build (manual 1.14.3.3)
    image: {{ published or 'fabric/bind9:local' }}
{% if not published %}
    build:
      context: {{ deploy_base_dir }}/bind9/build
      args:
        BASE_IMAGE: "{{ image_debian }}"
        BIND_UID: "{{ service_users.bind.uid }}"
        BIND_GID: "{{ service_users.bind.gid }}"
{% endif %}
    container_name: bind9
    # to the host journal (fabric-web, openbao, … by name): `docker logs` still works,
    # and the optional log forwarder reads everything from one place
    logging:
      driver: journald
      options:
        tag: "{{ '{{.Name}}' }}"
    user: "{{ service_users.bind.uid }}:{{ service_users.bind.gid }}"
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    tmpfs:
      - /run/named:uid={{ service_users.bind.uid }},gid={{ service_users.bind.gid }},mode=0755,size=4m
      - /tmp:noexec,nosuid,size=8m
      # Kerberos' replay cache for signed updates (GSS-TSIG)
      - /var/tmp:uid={{ service_users.bind.uid }},gid={{ service_users.bind.gid }},mode=0700,size=16m
    ports:
      - "{{ host_ip }}:{{ bind_dns_port }}:53/tcp"
      - "{{ host_ip }}:{{ bind_dns_port }}:53/udp"
    volumes:
      - {{ deploy_base_dir }}/bind9/config:/etc/bind:ro
      - {{ deploy_base_dir }}/bind9/data:/var/lib/bind
      - {{ deploy_base_dir }}/bind9/log:/var/log
      - {{ deploy_base_dir }}/bind9/cache:/var/cache/bind
      - {{ deploy_base_dir }}/bind9/ssl:/etc/bind9/ssl:ro
      # the Windows domain (manual 1.6.5.6): what fabric includes, the DC's DNS partition (DLZ writes members'
      # updates there) and the DC's smb.conf (its paths)
      - {{ deploy_base_dir }}/samba/bind:/etc/bind-samba:ro
      - {{ deploy_base_dir }}/samba/data/bind-dns:/data/bind-dns
      - {{ deploy_base_dir }}/samba/data/etc:/etc/samba:ro
    networks:
      fabric_net:
        ipv4_address: "{{ ip_bind9 }}"
        aliases:
          - "{{ hostname_bind9 }}"
{# its planned limit (manual 1.2.4.3); Samba's DLZ libraries need more than plain BIND (Q10: 69 MiB measured) #}
    deploy:
      resources:
        limits:
          memory: {{ memory_mb('bind9') }}M
    healthcheck:
      test: ["CMD", "rndc", "status"]
      interval: 10s
      start_period: 10s
      timeout: 5s
      retries: 3

networks:
  fabric_net:
    name: fabric_net
    external: true
