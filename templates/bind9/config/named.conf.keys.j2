{% if install_kea | default(false) and (dhcp | default({})).ddns | default(true) %}
// Kea DHCP-DDNS: may only change A/AAAA/DHCID in the DHCP subzone (design 2.1.4.1). While its key is being replaced
// (2.1.10.42) BIND knows the old one too, until Kea runs on the new one
{% for k in [{'name': kea_ddns_key | default('kea-ddns', true), 'secret': kea_ddns_secret}]
            + ([kea_ddns_old] if kea_ddns_old | default(none) else []) %}
key "{{ k.name }}" {
    algorithm hmac-sha256;
    secret "{{ k.secret }}";
};
{% endfor %}
{% endif %}
{% set fl = federation_links | default({'children': [], 'upstream': none}) %}
{% for link in fl.children + ([fl.upstream] if fl.upstream else []) %}
// Federation link to site {{ link.site }}: signs zone transfers both ways (manual 1.9 M4)
key "{{ link.key }}" {
    algorithm {{ link.algorithm }};
    secret "{{ link.secret }}";
};
{% endfor %}
{% for key in tsig_keys %}
key "{{ key.name }}" {
    algorithm {{ key.algorithm }};
    secret "{{ tsig_secrets[key.name] }}";
};
{% endfor %}
