{% extends "../shared/base.html.j2" %}

{% block title %}{{ friendly_name | default(ca_name) }} &mdash; Fabric{% endblock %}

{% block header_subtitle %}Fabric Landing Portal{% endblock %}

{% block back_link %}{% endblock %}

{% block content %}
    <div class="card" style="margin-top: 2rem;">
      {# a new device reads this over plain HTTP (2.1.4.3): it fetches the CA here and checks it before trusting it #}
      <h2 class="section-title" style="margin-top: 0;">Trust this network</h2>
      <p>Install this network's root certificate on a new device, then everything here opens over HTTPS.
         Download it from <a href="/certs/">/certs/</a> (every system's format) and check that its
         SHA-256 fingerprint is exactly:</p>
      <p><code id="root-fp">(see /certs/ca-certs.json)</code></p>
      <script>
        fetch("/certs/ca-certs.json").then(r => r.json()).then(info => {
          const root = info["root-ca"] || {};
          if (root.sha256) document.getElementById("root-fp").textContent = root.sha256;
        }).catch(() => {});
      </script>

      <h2 class="section-title">Documentation & Setup</h2>
      <ul class="link-list">
        <li><a href="https://{{ hostname_landing }}/manual/" class="btn">Infrastructure Manual (Documentation)</a></li>
        <li><a href="http://{{ hostname_landing }}/certs/" class="btn">CA Certificates (every system) & Installers</a></li>
        <li><a href="https://{{ hostname_landing }}/certs/#join" class="btn">Join a machine to the domain</a></li>
      </ul>

      {# links from the site's DNS records marked for the landing page (manual 1.4.2.2, 2.1.4.2) #}
      {% set zone = (dns | default({})).get('dynamic_zone_var', {}) %}
      {% set marked = [] %}
      {% for rtype in ['A', 'AAAA', 'CNAME'] %}{% for r in zone.get(rtype, []) or [] %}
        {% if r.link and '*' not in r.name %}
          {% set host = domain if r.name == '@' else r.name ~ '.' ~ domain %}
          {% set url = 'https://' ~ host ~ ((':' ~ r.link.port) if r.link.port else '') ~ (r.link.path or '/') %}
          {% set _ = marked.append({'label': r.link.label or host, 'url': url}) %}
        {% endif %}
      {% endfor %}{% endfor %}
      {% if marked %}
      <h2 class="section-title">This network</h2>
      <ul class="link-grid">
        {% for item in marked | sort(attribute='label') %}
        <li><a href="{{ item.url }}" class="btn">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
      {% endif %}
      {% if links is defined and links | length > 0 %}
      <h2 class="section-title">Links</h2>
      <ul class="link-grid">
        {% for item in links %}
        <li><a href="https://{{ item.link }}" class="btn">{{ item.name }}</a></li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
{% endblock %}
