#!/usr/bin/env bash
# Usage: sudo bash install-certs-{{ domain_file }}.sh <root CA SHA-256>
# The certificates come by plain HTTP, so none is installed until the root matches the fingerprint given and the
# intermediate is proved by that root (2.1.1.87).
set -euo pipefail

#--- Configuration -----------------------------------------------------------
CERT_BASE="http://{{ hostname_stepca }}/certs"
CERTS=("root-ca.crt" "intermediate-ca.crt")
TARGET_DIR="/usr/local/share/ca-certificates"
FP="${1:-}"

#--- Helper ------------------------------------------------------------------
die() { echo "ERROR: $*" >&2; exit 1; }
refuse() { echo "REFUSED: $* Nothing was installed." >&2; exit 1; }

#--- Ensure we run as root (or via sudo) -------------------------------------
if [[ $EUID -ne 0 ]]; then
    echo "This script must be run with sudo or as root."
    exit 1
fi

[[ -n "$FP" ]] || refuse "give the root CA's SHA-256, from the certificates page."

#--- Fetch every certificate, and check each before any is installed ----------
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
for name in "${CERTS[@]}"; do
    echo "Downloading ${CERT_BASE}/${name} ..."
    if command -v wget >/dev/null; then
        wget -nv "${CERT_BASE}/${name}" -O "$WORK/$name" || die "Failed to download ${CERT_BASE}/${name}"
    else
        curl -fsS "${CERT_BASE}/${name}" -o "$WORK/$name" || die "Failed to download ${CERT_BASE}/${name}"
    fi
    # one certificate each: a second in the file would be trusted unchecked
    [[ "$(grep -c -- '-----BEGIN CERTIFICATE-----' "$WORK/$name" || true)" == 1 ]] || refuse "$name is not one certificate."
done
got=$(openssl x509 -in "$WORK/root-ca.crt" -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2 | tr -d :) || true
if [[ -z "$got" || "$got" != "$(printf %s "$FP" | tr -d : | tr a-f A-F)" ]]; then
    refuse "the root certificate served (${got:-none}) is not the fingerprint you gave: it is not fabric's, or the fingerprint is wrong."
fi
openssl verify -no-CApath -no-CAstore -CAfile "$WORK/root-ca.crt" "$WORK/intermediate-ca.crt" >/dev/null 2>&1 ||
    refuse "the intermediate certificate served is not proved by that root."

#--- Create target directory if missing --------------------------------------
mkdir -p "$TARGET_DIR"

#--- Install and validate function -------------------------------------------
install_cert() {
    local name="$1"
    local prefix="$2"
    local tmp_file="$WORK/$name"

    # Remove any old certificates for this prefix to avoid conflicts
    rm -f "${TARGET_DIR}/${prefix}"*.crt

    # Normalize line endings to Unix style (CRLF -> LF)
    sed -i 's/\r$//' "$tmp_file"

    # Split bundle into individual certificates. 
    # update-ca-certificates expects exactly ONE certificate per .crt file.
    local count=0
    local in_cert=0
    local cert_file=""

    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" == "-----BEGIN CERTIFICATE-----" ]]; then
            count=$((count + 1))
            cert_file="${TARGET_DIR}/${prefix}-${count}.crt"
            in_cert=1
            > "$cert_file" # Create or truncate the file
        fi
        
        if [[ $in_cert -eq 1 ]]; then
            echo "$line" >> "$cert_file"
        fi

        if [[ "$line" == "-----END CERTIFICATE-----" ]]; then
            in_cert=0
            # Validate the extracted certificate
            if ! openssl x509 -in "$cert_file" -noout 2>/dev/null; then
                echo "Warning: Extracted certificate $cert_file is invalid. Removing."
                rm -f "$cert_file"
                count=$((count - 1))
            fi
        fi
    done < "$tmp_file"

    echo "Installed $count valid certificate(s) for $prefix"
}

#--- Download and install each certificate ------------------------------------
for name in "${CERTS[@]}"; do
    prefix="fabric-{{ domain_file }}-${name%.crt}"      # fabric-<domain>-root-ca / -intermediate-ca
    install_cert "$name" "$prefix"
done

#--- Update the system‑wide bundle -------------------------------------------
echo "Updating CA bundle"
update-ca-certificates --fresh || die "update-ca-certificates failed"

echo {{ ((friendly_name | default(domain)) ~ ' certificates installed successfully.') | sh }}

#--- Verify installation ------------------------------------------------------
echo "Verifying certificate installation against certificates.{{ domain }}..."

# Use the explicitly updated CA bundle if it exists (Ubuntu/Debian standard)
CA_ARGS=""
if [[ -f "/etc/ssl/certs/ca-certificates.crt" ]]; then
    CA_ARGS="-CAfile /etc/ssl/certs/ca-certificates.crt"
fi

VERIFY_OUT=$(echo | openssl s_client $CA_ARGS -servername "certificates.{{ domain }}" -connect "certificates.{{ domain }}:443" </dev/null 2>/dev/null | grep "Verify return code" || true)

if echo "$VERIFY_OUT" | grep -q "Verify return code: 0"; then
    echo "Verification successful: $VERIFY_OUT"
else
    echo "Warning: OpenSSL verification did not return 0."
    echo "Output: $VERIFY_OUT"
    echo "Note: If you still get code 19 (self-signed certificate in certificate chain), ensure your system's OpenSSL is configured to use the correct CA store."
fi
