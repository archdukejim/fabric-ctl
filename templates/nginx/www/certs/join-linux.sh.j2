#!/usr/bin/env bash
# Join this Linux machine (Ubuntu 24.04 or 26.04, Debian 12 or 13 — Proxmox VE 8 and 9 too) to fabric's domain
# {{ ad_domain }} (manual 1.6.7, 4.6.6).
#   sudo bash join-linux.sh <root CA SHA-256 fingerprint> --user <a site admin>   [--site <site>] [--name <name>]
#   sudo bash join-linux.sh <root CA SHA-256 fingerprint> --one-time              [--site <site>] [--name <name>]
#   --unmanaged: a plain member; fabric does not configure SSH and DNS here (manual 1.6.11.6)
# The fingerprint is shown on http://{{ hostname_stepca }}/certs/. The password - a site admin's, or with --one-time the
# machine's one-time join password from `fabricctl domain add-machine <name>` - is asked on the terminal (or read
# from standard input), never taken from the command line.
set -euo pipefail

AD_DOMAIN="{{ ad_domain }}"
REALM="{{ ad_realm }}"
BASE_DN="{{ ad_base_dn }}"
DC="{{ hostname_dc }}"
SITE="{{ site_name }}"
CERTS="http://{{ hostname_stepca }}/certs"
NTP="{{ hostname_ntp }}"
FABRIC_DNS="{{ host_ip }}"
DOMAIN="{{ domain }}"
# the fabric host's own name: its SSH user CA (manual 1.6.11.9.4) is fetched from it over verified HTTPS
FABRIC_HOST="{{ (hostname ~ '.' ~ domain) | lower }}"
# a site whose DC is read-only takes no writes: a machine writes its SSH host keys at the writable DC instead (manual
# 1.6.11.9.7; the same DC fabric writes at, samba/writable_server, 2.1.6.52); its name, for Kerberos
{% if ad_dc_type | default('writable', true) == 'rodc' %}RODC=1
WRITE_DC="{{ ad_join_server_name | default('', true) or ad_join_server | default('', true) }}"
{% else %}RODC=0
WRITE_DC=""
{% endif %}
die() { echo "ERROR: $*" >&2; exit 1; }
usage() { sed -n '2,8p' "$0" | cut -c3-; exit 2; }

[[ $EUID -eq 0 ]] || die "run as root (sudo)"
[[ $# -ge 1 ]] || usage
FP=$(printf '%s' "$1" | tr -d ':' | tr 'a-f' 'A-F')
shift
[[ $FP =~ ^[0-9A-F]{64}$ ]] || die "the first argument is the root CA's SHA-256 fingerprint (64 hex digits), shown on $CERTS/"
JOIN_USER=""
ONE_TIME=0
MANAGED=1
MACHINE=$(hostname -s | tr 'A-Z' 'a-z')
while [[ $# -gt 0 ]]; do
    case "$1" in
        --site) SITE="${2:-}"; shift 2 ;;
        --user) JOIN_USER="${2:-}"; shift 2 ;;
        --name) MACHINE="${2:-}"; shift 2 ;;
        --one-time) ONE_TIME=1; shift ;;
        --unmanaged) MANAGED=0; shift ;;
        *) usage ;;
    esac
done
[[ $SITE =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || die "not a site name: $SITE"
[[ $MACHINE =~ ^[a-z0-9]([a-z0-9-]{0,13}[a-z0-9])?$ ]] || die "the machine's name must be 1-15 letters, digits or dashes (--name): $MACHINE"
[[ $ONE_TIME -eq 1 || -n $JOIN_USER ]] || die "give --user <a site admin>, or --one-time (from: sudo fabricctl domain add-machine $MACHINE)"

# in a subshell: os-release's own variables (NAME, VERSION, …) must not overwrite this script's
release=$(. /etc/os-release && echo "${ID:-}-${VERSION_ID:-}")
# what the computer account records (operatingSystem, operatingSystemVersion: 2.1.6.36)
os_name=$(. /etc/os-release && echo "${NAME:-Linux}")
os_version=$(. /etc/os-release && echo "${VERSION_ID:-}")
case "$release" in
    ubuntu-24.04|ubuntu-26.04|debian-12|debian-13) ;;
    *) die "Ubuntu 24.04 or 26.04, or Debian 12 or 13 (Proxmox VE 8, 9) only (this is $release)" ;;
esac

# the password first, before anything on this machine changes
if [[ $ONE_TIME -eq 1 ]]; then prompt="one-time join password for $MACHINE"; else prompt="password of $JOIN_USER"; fi
if [[ -t 0 ]]; then
    read -rsp "$prompt: " PASSWORD
    echo
else
    IFS= read -r PASSWORD || true
fi
[[ -n $PASSWORD ]] || die "no password given"

export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq ca-certificates curl openssl >/dev/null

# fabric's root CA, fetched over plain HTTP (nothing is trusted yet) and kept only if its fingerprint matches
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
curl -fsS "$CERTS/root-ca.crt" -o "$tmp/root.crt" || die "cannot fetch $CERTS/root-ca.crt"
got=$(openssl x509 -in "$tmp/root.crt" -noout -fingerprint -sha256 | cut -d= -f2 | tr -d ':')
[[ $got == "$FP" ]] || die "the root CA served is $got, not the fingerprint given: not trusting it, nothing changed"
install -m 0644 "$tmp/root.crt" /usr/local/share/ca-certificates/fabric-root-ca.crt
update-ca-certificates >/dev/null
echo "trusted fabric's root CA ($FP)"

# sudo itself too: Debian and Proxmox VE do not install it
apt-get install -y -qq adcli sssd-ad sssd-tools libpam-sss libnss-sss libsss-sudo sudo krb5-user ldap-utils \
    libsasl2-modules-gssapi-mit >/dev/null

# Kerberos: the domain's realm; its KDCs from DNS, the site's DC when DNS has none
cat > /etc/krb5.conf <<EOF
[libdefaults]
    default_realm = $REALM
    dns_lookup_realm = false
    dns_lookup_kdc = true
    rdns = false

[realms]
    $REALM = {
        kdc = $DC
        admin_server = $DC
    }

[domain_realm]
    .$AD_DOMAIN = $REALM
    $AD_DOMAIN = $REALM
    .{{ domain }} = $REALM
EOF

# where the site sits (sites nest, each in its parent's OU: manual 1.9.8.14): its OU, the sites above it and the
# organisation's OU, read from the DC as the account that joins (a site admin, or the pre-created machine), signed in
# with Kerberos, the password on stdin
if [[ $ONE_TIME -eq 1 ]]; then PRINCIPAL="${MACHINE^^}\$@$REALM"; else PRINCIPAL="$JOIN_USER@$REALM"; fi
export KRB5CCNAME="FILE:$tmp/ccache"
printf '%s\n' "$PASSWORD" | kinit "$PRINCIPAL" >/dev/null 2>&1 || die "$PRINCIPAL could not sign in (the password?)"
lookup() {
    LDAPSASL_NOCANON=on ldapsearch -LLL -o ldif-wrap=no -Q -Y GSSAPI -H "ldap://$DC" -b "OU=sites,$BASE_DN" \
        "$1" dn 2>/dev/null | sed -n 's/^dn: //p'
}
SITE_DN=$(lookup "(&(objectClass=fabricSiteInfo)(ou=$SITE))")
[[ -n $SITE_DN && $SITE_DN != *$'\n'* ]] || die "no site $SITE in $AD_DOMAIN"
ORG_DN=$(lookup "(&(objectClass=organizationalUnit)(ou=organisation))")
[[ -n $ORG_DN && $ORG_DN != *$'\n'* ]] || die "no organisation OU in $AD_DOMAIN"
# sudo rules: the site's own, each site's above it (their roles reach the sites below, 2.1.9.13), the organisation's
SUDO_BASES=""
dn=$SITE_DN
while [[ ${dn^^} == OU=* && ${dn^^} != OU=SITES,* ]]; do
    SUDO_BASES+="OU=sudoers,$dn?onelevel??"
    dn=${dn#*,}
done
SUDO_BASES+="OU=sudoers,$ORG_DN?onelevel?"
# every site's uid/gid block (manual 1.6.3.17): local subordinate ids that overlap one are named below
ID_BLOCKS=$(LDAPSASL_NOCANON=on ldapsearch -LLL -o ldif-wrap=no -Q -Y GSSAPI -H "ldap://$DC" -b "OU=sites,$BASE_DN" \
    "(objectClass=fabricSiteInfo)" fabricIdRange 2>/dev/null | sed -n 's/^fabricIdRange: //p' | tr '\n' ' ')
[[ -n $ID_BLOCKS ]] || ID_BLOCKS="1000000-999999999"
kdestroy >/dev/null 2>&1 || true

# the join (the account's name in upper case, as Windows names them: SSSD looks for NAME$ in the keytab):
# a computer account in the site's OU=machines/OU=linux (pre-created with --one-time: where add-machine put it,
# manual 1.6.11.5), recording its OS; the password on stdin
# an unmanaged machine says so on its account: fabric's hourly sort leaves it out of <site>-fabric-machines
UNMANAGED=()
[[ $MANAGED -eq 1 ]] || UNMANAGED=(--description="fabric: unmanaged (manual 1.6.11.6)")
if [[ $ONE_TIME -eq 1 ]]; then
    printf '%s' "$PASSWORD" | adcli join --domain="$AD_DOMAIN" --domain-realm="$REALM" --domain-controller="$DC" \
        --computer-name="${MACHINE^^}" --login-type=computer --stdin-password \
        --os-name="$os_name" --os-version="$os_version" --show-details >/dev/null \
        || die "the join was refused (is $MACHINE pre-created with: fabricctl domain add-machine $MACHINE?)"
else
    printf '%s' "$PASSWORD" | adcli join --domain="$AD_DOMAIN" --domain-realm="$REALM" --domain-controller="$DC" \
        --computer-name="${MACHINE^^}" --login-user="$JOIN_USER" --stdin-password \
        --domain-ou="OU=linux,OU=machines,$SITE_DN" --os-name="$os_name" --os-version="$os_version" \
        "${UNMANAGED[@]}" \
        --show-details >/dev/null \
        || die "the join was refused (a site admin of $SITE, and the right password?)"
fi
unset PASSWORD
echo "joined $AD_DOMAIN as $MACHINE (site $SITE)"

# SSSD (manual 2.10.2.4-2.10.2.5): fabric's own ids, who may log on from the site's GPO, sudo from the site's rules
cat > /etc/sssd/sssd.conf <<EOF
[sssd]
domains = $AD_DOMAIN
services = nss, pam, sudo

[domain/$AD_DOMAIN]
id_provider = ad
access_provider = ad
sudo_provider = ad
ad_domain = $AD_DOMAIN
krb5_realm = $REALM
ad_server = _srv_, $DC
ad_gpo_access_control = enforcing
ldap_id_mapping = false
use_fully_qualified_names = false
fallback_homedir = /home/%u
default_shell = /bin/bash
cache_credentials = true
enumerate = false
ldap_sudo_search_base = $SUDO_BASES
EOF
chmod 0600 /etc/sssd/sssd.conf
pam-auth-update --enable mkhomedir >/dev/null

# local subordinate ids (rootless Podman and Docker) are not in AD: local users made from now on get theirs above
# AD's ids (above 2147483647, manual 1.6.3.17); ranges already given are named when they overlap a site's block,
# never moved (that would break their container storage)
set_login_def() {
    if grep -qE "^[[:space:]]*$1[[:space:]]" /etc/login.defs; then
        sed -i -E "s|^[[:space:]]*$1[[:space:]].*|$1\t\t$2|" /etc/login.defs
    else
        printf '%s\t\t%s\n' "$1" "$2" >> /etc/login.defs
    fi
}
for kind in UID GID; do
    set_login_def "SUB_${kind}_MIN" 2147483648
    set_login_def "SUB_${kind}_MAX" 4294000000
done
for file in /etc/subuid /etc/subgid; do
    [[ -f $file ]] || continue
    while IFS=: read -r owner start count; do
        [[ $start =~ ^[0-9]+$ && $count =~ ^[0-9]+$ ]] || continue
        for block in $ID_BLOCKS; do
            if (( start <= ${block#*-} && start + count - 1 >= ${block%-*} )); then
                echo "WARNING: local user $owner's subordinate ids in $file ($start-$((start + count - 1))) overlap" \
                     "the domain's ids ($block): left as they are (manual 1.6.3.17)" >&2
                break
            fi
        done
    done < "$file"
done

# sudo rules from the domain need sudo's own sss support: Ubuntu 26.04's default sudo-rs has none, so the classic
# sudo it also ships becomes the default
if [[ "$(readlink -f /usr/bin/sudo)" == */cargo/bin/sudo && -x /usr/bin/sudo.ws ]]; then
    update-alternatives --set sudo /usr/bin/sudo.ws >/dev/null
    echo "sudo: switched from sudo-rs to sudo (sudo-rs cannot read the domain's sudo rules)"
fi

# time from the site (Kerberos refuses more than 5 minutes of skew)
if [[ -d /etc/systemd/timesyncd.conf.d || -f /etc/systemd/timesyncd.conf ]]; then
    mkdir -p /etc/systemd/timesyncd.conf.d
    printf '[Time]\nNTP=%s\n' "$NTP" > /etc/systemd/timesyncd.conf.d/fabric.conf
    systemctl restart systemd-timesyncd 2>/dev/null || true
fi
# chrony instead (Proxmox VE's default): the site as a source of its own, beside the machine's others
if [[ -d /etc/chrony/sources.d ]]; then
    printf 'server %s iburst\n' "$NTP" > /etc/chrony/sources.d/fabric.sources
    chronyc reload sources >/dev/null 2>&1 || true
fi

{% if install_keycloak | default(false) | bool and signin_kerberos | default(false) | bool %}
# browsers (manual 2.3.6.2.6.5, 2.1.6.28): Firefox, Chromium and Chrome may use the logon's Kerberos ticket for
# {{ hostname_keycloak }}, so fabric's sign-in asks no password here. Firefox's policies are merged, never replaced.
SSO_HOST="{{ hostname_keycloak }}"
mkdir -p /etc/firefox/policies
python3 - "$SSO_HOST" <<'PY'
import json, os, sys
path, host = "/etc/firefox/policies/policies.json", sys.argv[1]
data = json.load(open(path)) if os.path.exists(path) else {}
spnego = data.setdefault("policies", {}).setdefault("Authentication", {}).setdefault("SPNEGO", [])
if host not in spnego:
    spnego.append(host)
json.dump(data, open(path, "w"), indent=2)
PY
for dir in /etc/chromium/policies/managed /etc/opt/chrome/policies/managed; do
    mkdir -p "$dir"
    printf '{"AuthServerAllowlist": "%s"}\n' "$SSO_HOST" > "$dir/fabric-sso.json"
done
echo "browsers: Kerberos sign-in to $SSO_HOST (Firefox, Chromium, Chrome)"
{% endif %}
# a machine fabric manages (manual 1.6.11.6): SSH with Kerberos, DNS for the domain from fabric, applied while the
# machine is in <site>-fabric-machines and removed when it is taken out; checked hourly by fabric-managed.timer
mkdir -p /etc/fabric
cat > /etc/fabric/managed.env <<EOF
MACHINE=$MACHINE
SITE=$SITE
REALM=$REALM
DC=$DC
BASE_DN=$BASE_DN
AD_DOMAIN=$AD_DOMAIN
DOMAIN=$DOMAIN
FABRIC_DNS=$FABRIC_DNS
FABRIC_HOST=$FABRIC_HOST
RODC=$RODC
WRITE_DC=$WRITE_DC
EOF
cat > /usr/local/sbin/fabric-managed <<'MANAGED'
#!/bin/bash
# fabric's configuration of a machine it manages (manual 1.6.11.6), installed by join-linux.sh:
#   fabric-managed apply | remove | check     (check: apply while in <site>-fabric-machines, remove when not)
set -euo pipefail
. /etc/fabric/managed.env
# 10-: sshd keeps the first value it reads, and Ubuntu's cloud images set passwords on in 50-cloud-init.conf
SSHD=/etc/ssh/sshd_config.d/10-fabric.conf
RESOLVED=/etc/systemd/resolved.conf.d/fabric.conf
SSH_CA=/etc/ssh/fabric-user-ca.pub      # fabric's SSH user CA (manual 1.6.11.9.4), while SSH certificates are on
HOST_CA=/etc/ssh/fabric-host-ca.pub     # fabric's SSH host CA (manual 1.6.11.9.9), while SSH certificates are on
REVOKED=/etc/ssh/fabric-host-revoked.pub  # host keys whose certificates fabric withdrew (1.6.11.9.12): @revoked
HOST_CERT=/etc/ssh/fabric-host-cert     # + -<ed25519|ecdsa|rsa>.pub: this machine's host certificates (1.6.11.9.8)
KNOWN=/etc/ssh/ssh_known_hosts
BEGIN="# fabric: SSH host CA, begin (manual 1.6.11.9.9; written by fabric, kept in step with SSH certificates)"
END="# fabric: SSH host CA, end"
CC=""
TARGET=""                               # the DC an LDAP tool talks to: $DC, or the writable DC for a write

reload() {
    systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
    systemctl try-restart systemd-resolved 2>/dev/null || true
}
write() {   # write $1 from stdin if it differs; true when it changed
    local tmp="$1.tmp"
    cat > "$tmp"
    if cmp -s "$tmp" "$1"; then rm -f "$tmp"; return 1; fi
    mv "$tmp" "$1"
}
ssh_ca() {  # one of fabric's SSH CAs ($2: ssh-user-ca.pub 1.6.11.9.4, ssh-host-ca.pub 1.6.11.9.9): 0 published (in
            # $1), 1 not published (off), 2 unknown
    local code
    [[ -n ${FABRIC_HOST:-} ]] || return 2   # joined before 0.9: re-run the join to learn the host's name
    code=$(curl -sS --max-time 20 -o "$1" -w '%{http_code}' "https://$FABRIC_HOST/certs/$2" 2>/dev/null) \
        || return 2                      # unreachable, or its certificate not fabric's: unknown, nothing changes
    if [[ $code == 404 ]]; then return 1; fi
    [[ $code == 200 ]] && grep -qE '^(ssh-ed25519|ecdsa-sha2-nistp[0-9]+|ssh-rsa) [A-Za-z0-9+/=]+( .*)?$' "$1" \
        && [[ $(wc -l < "$1") -le 1 ]] || return 2
}
as_machine() {  # an LDAP tool ($1) against the DC, signed in as this machine (its keytab), one ticket per run
    if [[ -z $CC ]]; then
        CC=$(mktemp)
        trap 'rm -f "$CC"' EXIT
        KRB5CCNAME="FILE:$CC" kinit -k "${MACHINE^^}\$@$REALM" >/dev/null 2>&1 || return 2
    fi
    local tool=$1
    shift
    KRB5CCNAME="FILE:$CC" LDAPSASL_NOCANON=on "$tool" -o ldif-wrap=no -Q -Y GSSAPI -H "ldap://${TARGET:-$DC}" "$@"
}
loud() {        # a refusal the owner must see: on standard error (the service's journal) and in syslog
    echo "fabric-managed: REFUSED: $*" >&2
    logger -t fabric-managed -p user.err "REFUSED: $*" 2>/dev/null || true
}
fetch_revoked() {  # fabric's revoked host keys (1.6.11.9.12) into $REVOKED: 200 replaces the list, 404 empties it,
                   # anything else keeps the last one (never trust less because the host was unreachable)
    local code tmp
    tmp=$(mktemp)
    code=$(curl -sS --max-time 20 -o "$tmp" -w '%{http_code}' "https://$FABRIC_HOST/certs/ssh-host-revoked.pub" \
        2>/dev/null) || code=000
    if [[ $code == 404 ]]; then
        : > "$tmp"
    elif [[ $code != 200 ]] || grep -qvE '^(ssh-ed25519|ecdsa-sha2-nistp[0-9]+|ssh-rsa) [A-Za-z0-9+/=]+$' "$tmp"; then
        rm -f "$tmp"
        return 0
    fi
    write "$REVOKED" < "$tmp" || true
    chmod 0644 "$REVOKED"
    rm -f "$tmp"
}
known_block() {   # $1: the host CA's key file -> fabric's known-hosts lines (the domain's names, then short names)
    local key
    key=$(awk '{print $1" "$2}' "$1")
    printf '%s\n' "$BEGIN" "@cert-authority *.${AD_DOMAIN,,},*.${DOMAIN,,} $key" "@cert-authority *,!*.*,!*:* $key"
    if [[ -s $REVOKED ]]; then sort -u "$REVOKED" | sed 's/^/@revoked * /'; fi
    printf '%s\n' "$END"
}
set_known() {     # fabric's block in /etc/ssh/ssh_known_hosts, from $1 (the host CA's file) or removed ($1 ""); true
                  # when the file changed
    local rest
    [[ -d /etc/ssh ]] || return 1
    rest=$(awk -v b="$BEGIN" -v e="$END" '$0==b{skip=1;next} $0==e&&skip{skip=0;next} !skip' "$KNOWN" 2>/dev/null || true)
    if [[ -z $rest && -z $1 ]]; then
        [[ -e $KNOWN ]] || return 1
        rm -f "$KNOWN"
        return 0
    fi
    { if [[ -n $rest ]]; then printf '%s\n' "$rest"; fi
      if [[ -n $1 ]]; then known_block "$1"; fi; } | write "$KNOWN" || return 1
    chmod 0644 "$KNOWN"
}
host_certs() {    # this machine's host keys published on its own account; the certificates fabric signed taken back,
                  # each checked (a host certificate of one of its keys, from the host CA, naming it, still valid);
                  # true when a certificate file changed. Nothing changes when the DC does not answer.
    local found dn have want certs line info valid_to fp family f now ca_fp kept="" changed_cert=0
    command -v ssh-keygen >/dev/null || return 1
    found=$(as_machine ldapsearch -LLL -b "$BASE_DN" "(sAMAccountName=${MACHINE^^}\$)" dn fabricSshHostKey \
        fabricSshHostCert 2>/dev/null) || return 1
    dn=$(printf '%s\n' "$found" | sed -n 's/^dn: //p')
    [[ -n $dn ]] || return 1
    have=$(printf '%s\n' "$found" | sed -n 's/^fabricSshHostKey: //p' | sort)
    want=$(for f in /etc/ssh/ssh_host_ed25519_key.pub /etc/ssh/ssh_host_ecdsa_key.pub /etc/ssh/ssh_host_rsa_key.pub; do
               if [[ -r $f ]]; then awk '{print $1" "$2}' "$f"; fi; done | sort)
    if [[ -n $want && $want != "$have" ]]; then
        local at=$DC rc=0
        if [[ ${RODC:-0} == 1 ]]; then at=${WRITE_DC:-}; fi   # a read-only DC takes no writes: the writable one (2.1.6.52)
        if [[ -z $at ]]; then
            loud "this site's domain controller is read-only and no writable one is known: host keys not published" \
                "(join the machine again with the current installer)"
        else
            { printf 'dn: %s\nchangetype: modify\nreplace: fabricSshHostKey\n' "$dn"
              printf '%s\n' "$want" | sed 's/^/fabricSshHostKey: /'
              printf -- '-\n'; } | TARGET=$at as_machine ldapmodify >/dev/null 2>&1 || rc=$?
            if [[ $rc -eq 0 ]]; then
                echo "fabric-managed: host keys published for signing (at $at)"
            elif [[ $rc -eq 255 || $rc -eq 2 ]]; then
                loud "the domain controller $at does not answer: host keys not published (nothing changed)"
            elif [[ $rc -eq 10 ]]; then     # a referral: a read-only DC this machine was not told about
                loud "the domain controller $at is read-only: host keys not published; join the machine again with"                     "the current installer, which names the writable one"
            else
                echo "fabric-managed: host keys not published yet (fabric prepares this machine's account within the hour)" >&2
            fi
        fi
    fi
    certs=$(printf '%s\n' "$found" | sed -n 's/^fabricSshHostCert: //p')
    ca_fp=$(ssh-keygen -lf "$HOST_CA" 2>/dev/null | awk '{print $2}')
    now=$(date +%s)
    while IFS= read -r line; do
        [[ -n $line && -n $ca_fp ]] || continue
        printf '%s\n' "$line" > "$HOST_CERT.check"
        info=$(ssh-keygen -L -f "$HOST_CERT.check" 2>/dev/null) || continue
        grep -q 'host certificate$' <<< "$info" || continue
        grep -q "Signing CA: .* $ca_fp " <<< "$info" || continue
        grep -qx " *${MACHINE,,}" <<< "$info" || continue
        valid_to=$(sed -n 's/^ *Valid: from .* to //p' <<< "$info")
        [[ -n $valid_to && $valid_to != forever ]] || continue
        [[ $(date -d "$valid_to" +%s 2>/dev/null || echo 0) -gt $now ]] || continue
        fp=$(sed -n 's/^ *Public key: [A-Z0-9-]* //p' <<< "$info")
        for f in /etc/ssh/ssh_host_ed25519_key.pub /etc/ssh/ssh_host_ecdsa_key.pub /etc/ssh/ssh_host_rsa_key.pub; do
            [[ -r $f && $(ssh-keygen -lf "$f" | awk '{print $2}') == "$fp" ]] || continue
            family=${f#/etc/ssh/ssh_host_}
            family=${family%_key.pub}
            if write "$HOST_CERT-$family.pub" < "$HOST_CERT.check"; then changed_cert=1; fi
            chmod 0644 "$HOST_CERT-$family.pub"
            kept="$kept $family"
        done
    done <<< "$certs"
    rm -f "$HOST_CERT.check"
    for f in "$HOST_CERT"-*.pub; do            # a certificate fabric no longer holds for one of its keys
        [[ -e $f ]] || continue
        family=${f#"$HOST_CERT"-}
        family=${family%.pub}
        if [[ " $kept " != *" $family "* ]]; then rm -f "$f"; changed_cert=1; fi
    done
    [[ $changed_cert -eq 1 ]]
}
sshd_text() {     # the drop-in, from what is on disk now
    printf '%s\n' "# fabric (manual 1.6.11.6): domain sign-in with Kerberos; who may sign in is the OU's log-on policy" \
        "GSSAPIAuthentication yes" "GSSAPICleanupCredentials yes" "PasswordAuthentication no" \
        "KbdInteractiveAuthentication no" "UsePAM yes"
    if [[ -e $SSH_CA ]]; then
        printf '%s\n' "# fabric (manual 1.6.11.9): 8-hour certificates for the fabric admins, signed by fabric's SSH CA" \
            "TrustedUserCAKeys $SSH_CA"
    fi
    for f in "$HOST_CERT"-*.pub; do
        if [[ -e $f ]]; then
            printf '%s\n' "# fabric (manual 1.6.11.9.8): this machine's host certificate" "HostCertificate $f"
        fi
    done
}
apply() {
    local changed=0 ca_rc=0 host_rc=0 ca_file
    ca_file=$(mktemp)
    ssh_ca "$ca_file" ssh-user-ca.pub || ca_rc=$?
    if [[ $ca_rc -eq 0 ]]; then
        write "$SSH_CA" < "$ca_file" && changed=1
        chmod 0644 "$SSH_CA"
    elif [[ $ca_rc -eq 1 && -e $SSH_CA ]]; then
        rm -f "$SSH_CA"; changed=1
    fi
    ssh_ca "$ca_file" ssh-host-ca.pub || host_rc=$?
    if [[ $host_rc -eq 0 ]]; then              # on: the host CA trusted as a client; this machine's certificates
        write "$HOST_CA" < "$ca_file" && changed=1
        chmod 0644 "$HOST_CA"
        fetch_revoked
        set_known "$HOST_CA" && changed=1
        if [[ -d /etc/ssh/sshd_config.d ]] && host_certs; then changed=1; fi
    elif [[ $host_rc -eq 1 ]]; then            # off: the certificates, the trust and the CA removed
        if [[ -e $HOST_CA ]] || compgen -G "$HOST_CERT-*.pub" >/dev/null; then
            rm -f "$HOST_CA" "$HOST_CERT"-*.pub; changed=1
        fi
        rm -f "$REVOKED"
        set_known "" && changed=1
    fi
    rm -f "$ca_file"
    if [[ -d /etc/ssh/sshd_config.d ]] && sshd_text | write "$SSHD"; then
        changed=1
        if command -v sshd >/dev/null && ! sshd -t 2>/dev/null; then   # a host certificate sshd refuses: dropped
            rm -f "$HOST_CERT"-*.pub
            sshd_text | write "$SSHD" || true
            echo "fabric-managed: sshd refused the host certificates; removed them" >&2
        fi
    fi
    mkdir -p /etc/systemd/resolved.conf.d
    printf '[Resolve]\n# fabric (manual 1.6.11.6): the domain names from fabric; other names as the machine had them\nDNS=%s\nDomains=~%s ~%s\n' \
        "$FABRIC_DNS" "$AD_DOMAIN" "$DOMAIN" | write "$RESOLVED" && changed=1
    if [[ $changed -eq 1 ]]; then reload; echo "fabric-managed: applied"; fi
}
remove() {
    if [[ -e $SSHD || -e $RESOLVED || -e $SSH_CA || -e $HOST_CA ]] || compgen -G "$HOST_CERT-*.pub" >/dev/null; then
        rm -f "$SSHD" "$RESOLVED" "$SSH_CA" "$HOST_CA" "$REVOKED" "$HOST_CERT"-*.pub
        set_known "" || true
        reload
        echo "fabric-managed: removed (no longer in $SITE-fabric-machines)"
    fi
}
member() {  # whether this machine is in <site>-fabric-machines, asked of the DC as the machine itself
    local cc
    cc=$(mktemp)
    trap 'rm -f "$cc"' RETURN
    KRB5CCNAME="FILE:$cc" kinit -k "${MACHINE^^}\$@$REALM" >/dev/null 2>&1 || return 2
    KRB5CCNAME="FILE:$cc" LDAPSASL_NOCANON=on ldapsearch -LLL -o ldif-wrap=no -Q -Y GSSAPI -H "ldap://$DC" \
        -b "$BASE_DN" "(sAMAccountName=${MACHINE^^}\$)" memberOf 2>/dev/null | grep -qi "^memberOf: CN=$SITE-fabric-machines,"
}
case "${1:-check}" in
    apply) apply ;;
    remove) remove ;;
    check)
        rc=0; member || rc=$?
        if [[ $rc -eq 0 ]]; then apply; elif [[ $rc -eq 1 ]]; then remove; else echo "fabric-managed: the DC did not answer; nothing changed" >&2; exit 1; fi ;;
    *) echo "usage: fabric-managed apply|remove|check" >&2; exit 2 ;;
esac
MANAGED
chmod 0755 /usr/local/sbin/fabric-managed
cat > /etc/systemd/system/fabric-managed.service <<'EOF'
[Unit]
Description=fabric: this machine's managed configuration, as its membership says (manual 1.6.11.6)
After=network-online.target sssd.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fabric-managed check
EOF
cat > /etc/systemd/system/fabric-managed.timer <<'EOF'
[Unit]
Description=fabric: check this machine's managed configuration hourly (manual 1.6.11.6)

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h

[Install]
WantedBy=timers.target
EOF
systemctl daemon-reload 2>/dev/null || true
systemctl enable --now fabric-managed.timer >/dev/null 2>&1 || true
if [[ $MANAGED -eq 1 ]]; then
    /usr/local/sbin/fabric-managed apply
    echo "managed by fabric: SSH with Kerberos (passwords off; keys still work), the domain's names from fabric's DNS"
else
    echo "unmanaged: fabric configures nothing more here"
fi
systemctl restart sssd
systemctl enable sssd >/dev/null 2>&1 || true
echo "done: people of $SITE can log on here (the site's log-on rights); sudo follows the site's rules"
