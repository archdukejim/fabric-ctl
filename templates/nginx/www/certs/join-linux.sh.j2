#!/usr/bin/env bash
# Join this Linux machine (Ubuntu 24.04 or 26.04, Debian 12 or 13 — Proxmox VE 8 and 9 too) to fabric's domain
# {{ ad_domain }} (manual 1.6.7, 4.6.6).
#   sudo bash join-linux.sh <root CA SHA-256 fingerprint> --user <an admin> [--type server|desktop] [--site <site>] [--name <name>]
#   sudo bash join-linux.sh <root CA SHA-256 fingerprint> --one-time        [--site <site>] [--name <name>]
#   --type: server (the default) or desktop: the machine's OU and group (manual 1.6.13.3); with --one-time, the type
#   add-machine gave it.  --unmanaged: a plain member; fabric does not configure SSH and DNS here (manual 1.6.11.6)
# The fingerprint is shown on http://{{ hostname_stepca }}/certs/. The password - an admin's (a Directory Administrator,
# 1.6.12.2), or with --one-time the machine's one-time join password from `fabricctl domain add-machine <name>` - is
# asked on the terminal (or read from standard input), never taken from the command line.
set -euo pipefail

AD_DOMAIN="{{ ad_domain }}"
REALM="{{ ad_realm }}"
BASE_DN="{{ ad_base_dn }}"
DC="{{ hostname_dc }}"
SITE="{{ site_name }}"
CERTS="http://{{ hostname_stepca }}/certs"
NTP="{{ hostname_ntp }}"
FABRIC_DNS="{{ host_ip }}"
DOMAIN="{{ domain }}"

die() { echo "ERROR: $*" >&2; exit 1; }
usage() { sed -n '2,10p' "$0" | cut -c3-; exit 2; }

[[ $EUID -eq 0 ]] || die "run as root (sudo)"
[[ $# -ge 1 ]] || usage
FP=$(printf '%s' "$1" | tr -d ':' | tr 'a-f' 'A-F')
shift
[[ $FP =~ ^[0-9A-F]{64}$ ]] || die "the first argument is the root CA's SHA-256 fingerprint (64 hex digits), shown on $CERTS/"
JOIN_USER=""
ONE_TIME=0
MANAGED=1
TYPE=server
MACHINE=$(hostname -s | tr 'A-Z' 'a-z')
while [[ $# -gt 0 ]]; do
    case "$1" in
        --site) SITE="${2:-}"; shift 2 ;;
        --user) JOIN_USER="${2:-}"; shift 2 ;;
        --name) MACHINE="${2:-}"; shift 2 ;;
        --type) TYPE="${2:-}"; shift 2 ;;
        --one-time) ONE_TIME=1; shift ;;
        --unmanaged) MANAGED=0; shift ;;
        *) usage ;;
    esac
done
[[ $SITE =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || die "not a site name: $SITE"
[[ $MACHINE =~ ^[a-z0-9]([a-z0-9-]{0,13}[a-z0-9])?$ ]] || die "the machine's name must be 1-15 letters, digits or dashes (--name): $MACHINE"
[[ $ONE_TIME -eq 1 || -n $JOIN_USER ]] || die "give --user <an admin>, or --one-time (from: sudo fabricctl domain add-machine $MACHINE)"
# a machine's type: its OU under OU=machines and its group (manual 1.6.13.3)
case "$TYPE" in
    server) TYPE_OU=servers ;;
    desktop) TYPE_OU=desktops ;;
    *) die "--type is server or desktop (a network machine is pre-created: fabricctl domain add-machine --type network): $TYPE" ;;
esac

# in a subshell: os-release's own variables (NAME, VERSION, …) must not overwrite this script's
release=$(. /etc/os-release && echo "${ID:-}-${VERSION_ID:-}")
# what the computer account records (operatingSystem, operatingSystemVersion: 2.1.6.36)
os_name=$(. /etc/os-release && echo "${NAME:-Linux}")
os_version=$(. /etc/os-release && echo "${VERSION_ID:-}")
case "$release" in
    ubuntu-24.04|ubuntu-26.04|debian-12|debian-13) ;;
    *) die "Ubuntu 24.04 or 26.04, or Debian 12 or 13 (Proxmox VE 8, 9) only (this is $release)" ;;
esac

# the password first, before anything on this machine changes
if [[ $ONE_TIME -eq 1 ]]; then prompt="one-time join password for $MACHINE"; else prompt="password of $JOIN_USER"; fi
if [[ -t 0 ]]; then
    read -rsp "$prompt: " PASSWORD
    echo
else
    IFS= read -r PASSWORD || true
fi
[[ -n $PASSWORD ]] || die "no password given"

export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq ca-certificates curl openssl >/dev/null

# fabric's root CA, fetched over plain HTTP (nothing is trusted yet) and kept only if its fingerprint matches
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
curl -fsS "$CERTS/root-ca.crt" -o "$tmp/root.crt" || die "cannot fetch $CERTS/root-ca.crt"
got=$(openssl x509 -in "$tmp/root.crt" -noout -fingerprint -sha256 | cut -d= -f2 | tr -d ':')
[[ $got == "$FP" ]] || die "the root CA served is $got, not the fingerprint given: not trusting it, nothing changed"
install -m 0644 "$tmp/root.crt" /usr/local/share/ca-certificates/fabric-root-ca.crt
update-ca-certificates >/dev/null
echo "trusted fabric's root CA ($FP)"

# sudo itself too: Debian and Proxmox VE do not install it
apt-get install -y -qq adcli sssd-ad sssd-tools libpam-sss libnss-sss libsss-sudo sudo krb5-user ldap-utils \
    libsasl2-modules-gssapi-mit >/dev/null

# Kerberos: the domain's realm; its KDCs from DNS, the site's DC when DNS has none
cat > /etc/krb5.conf <<EOF
[libdefaults]
    default_realm = $REALM
    dns_lookup_realm = false
    dns_lookup_kdc = true
    rdns = false

[realms]
    $REALM = {
        kdc = $DC
        admin_server = $DC
    }

[domain_realm]
    .$AD_DOMAIN = $REALM
    $AD_DOMAIN = $REALM
    .{{ domain }} = $REALM
EOF

# the domain's state (manual 1.6.13.2, 2.1.6.79), read from the DC as the account that joins (an admin, or the
# pre-created machine), signed in with Kerberos, the password on stdin: the site exists (a DC of it has a record) and
# every DC's uid/gid range, which local subordinate ids may not overlap (named below)
if [[ $ONE_TIME -eq 1 ]]; then PRINCIPAL="${MACHINE^^}\$@$REALM"; else PRINCIPAL="$JOIN_USER@$REALM"; fi
export KRB5CCNAME="FILE:$tmp/ccache"
printf '%s\n' "$PASSWORD" | kinit "$PRINCIPAL" >/dev/null 2>&1 || die "$PRINCIPAL could not sign in (the password?)"
DCS="CN=dcs,CN=fabric,CN=System,$BASE_DN"
records() {
    LDAPSASL_NOCANON=on ldapsearch -LLL -o ldif-wrap=no -Q -Y GSSAPI -H "ldap://$DC" -b "$DCS" -s one \
        "$1" "$2" 2>/dev/null | sed -n "s/^$2: //p"
}
[[ -n $(records "(&(objectClass=fabricDcInfo)(fabricSite=$SITE))" cn) ]] || die "no site $SITE in $AD_DOMAIN"
ID_BLOCKS=$(records "(objectClass=fabricDcInfo)" fabricIdRange | tr '\n' ' ')
[[ -n $ID_BLOCKS ]] || ID_BLOCKS="1000000-1999999999"
# sudo rules: the domain's, in OU=sudoers (2.1.6.80)
SUDO_BASES="OU=sudoers,$BASE_DN?onelevel?"

# the join (the account's name in upper case, as Windows names them: SSSD looks for NAME$ in the keytab):
# a computer account in its type's OU (pre-created with --one-time: where add-machine put it, manual 1.6.13.3),
# recording its OS; the password on stdin
# an unmanaged machine says so on its account: fabric's hourly sort leaves it out of fabric-managed
UNMANAGED=()
MANAGED_PENDING=0
[[ $MANAGED -eq 1 ]] || UNMANAGED=(--description="fabric: unmanaged (manual 1.6.11.6)")
if [[ $ONE_TIME -eq 1 ]]; then
    printf '%s' "$PASSWORD" | adcli join --domain="$AD_DOMAIN" --domain-realm="$REALM" --domain-controller="$DC" \
        --computer-name="${MACHINE^^}" --login-type=computer --stdin-password \
        --os-name="$os_name" --os-version="$os_version" --show-details >/dev/null \
        || die "the join was refused (is $MACHINE pre-created with: fabricctl domain add-machine $MACHINE?)"
else
    printf '%s' "$PASSWORD" | adcli join --domain="$AD_DOMAIN" --domain-realm="$REALM" --domain-controller="$DC" \
        --computer-name="${MACHINE^^}" --login-user="$JOIN_USER" --stdin-password \
        --domain-ou="OU=$TYPE_OU,OU=machines,$BASE_DN" --os-name="$os_name" --os-version="$os_version" \
        "${UNMANAGED[@]}" \
        --show-details >/dev/null \
        || die "the join was refused (an admin's account, and the right password?)"
    # its type's group and its site's (manual 1.6.13.3), as the admin who joined it; one it is in already is kept
    COMPUTER="CN=${MACHINE^^},OU=$TYPE_OU,OU=machines,$BASE_DN"
    for group in "machines-$TYPE_OU" "site-$SITE"; do
        out=$(printf 'dn: CN=%s,OU=groups,%s\nchangetype: modify\nadd: member\nmember: %s\n' "$group" "$BASE_DN" "$COMPUTER" \
            | LDAPSASL_NOCANON=on ldapmodify -Q -Y GSSAPI -H "ldap://$DC" 2>&1) \
            || [[ $out == *"Type or value exists"* || $out == *"(20)"* || $out == *"member already exists"* ]] \
            || die "$MACHINE joined, but could not be put in $group: $out"
    done
    # a managed machine is in fabric-managed from its join, so its own timer keeps what the join applies (1.6.11.6,
    # 2.1.6.97); an admin who may not change that group leaves it to the root's hourly sort (and the timer's guard)
    if [[ $MANAGED -eq 1 ]]; then
        out=$(printf 'dn: CN=fabric-managed,OU=groups,%s\nchangetype: modify\nadd: member\nmember: %s\n' "$BASE_DN" "$COMPUTER" \
            | LDAPSASL_NOCANON=on ldapmodify -Q -Y GSSAPI -H "ldap://$DC" 2>&1) \
            || [[ $out == *"Type or value exists"* || $out == *"(20)"* || $out == *"member already exists"* ]] \
            || { MANAGED_PENDING=1
                 echo "warning: $MACHINE is not in fabric-managed yet ($JOIN_USER may not change it): fabric's hourly sort adds it" >&2; }
    fi
fi
kdestroy >/dev/null 2>&1 || true
unset PASSWORD
echo "joined $AD_DOMAIN as $MACHINE (site $SITE$([[ $ONE_TIME -eq 1 ]] || echo ", a $TYPE"))"

# SSSD (manual 2.10.2.4-2.10.2.5): fabric's own ids, who may log on from the domain's GPOs, sudo from the domain's
# rules
cat > /etc/sssd/sssd.conf <<EOF
[sssd]
domains = $AD_DOMAIN
services = nss, pam, sudo

[domain/$AD_DOMAIN]
id_provider = ad
access_provider = ad
sudo_provider = ad
ad_domain = $AD_DOMAIN
krb5_realm = $REALM
ad_server = _srv_, $DC
ad_gpo_access_control = enforcing
ldap_id_mapping = false
use_fully_qualified_names = false
fallback_homedir = /home/%u
default_shell = /bin/bash
cache_credentials = true
enumerate = false
ldap_sudo_search_base = $SUDO_BASES
EOF
chmod 0600 /etc/sssd/sssd.conf
# sssd starts its responders itself (services = above). The packages' socket units (sssd-nss.socket, -pam, -sudo,
# -pac, ...: enabled by default on Ubuntu 24.04 and Debian 12) would start them a second way and fail at every boot
# beside services (manual 1.6.7.8, 2.1.6.95): disabled and masked, so a package upgrade does not enable them again
mapfile -t sockets < <(systemctl list-unit-files 'sssd-*.socket' --no-legend 2>/dev/null | awk '{print $1}')
if [[ -n "${sockets[*]:-}" ]]; then
    systemctl disable --now "${sockets[@]}" >/dev/null 2>&1 || true
    systemctl mask "${sockets[@]}" >/dev/null 2>&1 || true
fi
pam-auth-update --enable mkhomedir >/dev/null

# local subordinate ids (rootless Podman and Docker) are not in AD: local users made from now on get theirs above
# AD's ids (above 2147483647, manual 1.6.3.17); ranges already given are named when they overlap a DC's range,
# never moved (that would break their container storage)
set_login_def() {
    if grep -qE "^[[:space:]]*$1[[:space:]]" /etc/login.defs; then
        sed -i -E "s|^[[:space:]]*$1[[:space:]].*|$1\t\t$2|" /etc/login.defs
    else
        printf '%s\t\t%s\n' "$1" "$2" >> /etc/login.defs
    fi
}
for kind in UID GID; do
    set_login_def "SUB_${kind}_MIN" 2147483648
    set_login_def "SUB_${kind}_MAX" 4294000000
done
for file in /etc/subuid /etc/subgid; do
    [[ -f $file ]] || continue
    while IFS=: read -r owner start count; do
        [[ $start =~ ^[0-9]+$ && $count =~ ^[0-9]+$ ]] || continue
        for block in $ID_BLOCKS; do
            if (( start <= ${block#*-} && start + count - 1 >= ${block%-*} )); then
                echo "WARNING: local user $owner's subordinate ids in $file ($start-$((start + count - 1))) overlap" \
                     "the domain's ids ($block): left as they are (manual 1.6.3.17)" >&2
                break
            fi
        done
    done < "$file"
done

# sudo rules from the domain need sudo's own sss support: Ubuntu 26.04's default sudo-rs has none, so the classic
# sudo it also ships becomes the default
if [[ "$(readlink -f /usr/bin/sudo)" == */cargo/bin/sudo && -x /usr/bin/sudo.ws ]]; then
    update-alternatives --set sudo /usr/bin/sudo.ws >/dev/null
    echo "sudo: switched from sudo-rs to sudo (sudo-rs cannot read the domain's sudo rules)"
fi

# time from the site (Kerberos refuses more than 5 minutes of skew)
if [[ -d /etc/systemd/timesyncd.conf.d || -f /etc/systemd/timesyncd.conf ]]; then
    mkdir -p /etc/systemd/timesyncd.conf.d
    printf '[Time]\nNTP=%s\n' "$NTP" > /etc/systemd/timesyncd.conf.d/fabric.conf
    systemctl restart systemd-timesyncd 2>/dev/null || true
fi
# chrony instead (Proxmox VE's default): the site as a source of its own, beside the machine's others
if [[ -d /etc/chrony/sources.d ]]; then
    printf 'server %s iburst\n' "$NTP" > /etc/chrony/sources.d/fabric.sources
    chronyc reload sources >/dev/null 2>&1 || true
fi

{% if install_keycloak | default(false) | bool and signin_kerberos | default(false) | bool %}
# browsers (manual 2.3.6.2.6.5, 2.1.6.28): Firefox, Chromium and Chrome may use the logon's Kerberos ticket for
# {{ hostname_keycloak }}, so fabric's sign-in asks no password here. Firefox's policies are merged, never replaced.
SSO_HOST="{{ hostname_keycloak }}"
mkdir -p /etc/firefox/policies
python3 - "$SSO_HOST" <<'PY'
import json, os, sys
path, host = "/etc/firefox/policies/policies.json", sys.argv[1]
data = json.load(open(path)) if os.path.exists(path) else {}
spnego = data.setdefault("policies", {}).setdefault("Authentication", {}).setdefault("SPNEGO", [])
if host not in spnego:
    spnego.append(host)
json.dump(data, open(path, "w"), indent=2)
PY
for dir in /etc/chromium/policies/managed /etc/opt/chrome/policies/managed; do
    mkdir -p "$dir"
    printf '{"AuthServerAllowlist": "%s"}\n' "$SSO_HOST" > "$dir/fabric-sso.json"
done
echo "browsers: Kerberos sign-in to $SSO_HOST (Firefox, Chromium, Chrome)"
{% endif %}
# a machine fabric manages (manual 1.6.11.6): SSH with Kerberos, DNS for the domain from fabric, applied while the
# machine is in fabric-managed and removed when it is taken out; checked hourly by fabric-managed.timer
mkdir -p /etc/fabric
cat > /etc/fabric/managed.env <<EOF
MACHINE=$MACHINE
SITE=$SITE
REALM=$REALM
DC=$DC
BASE_DN=$BASE_DN
AD_DOMAIN=$AD_DOMAIN
DOMAIN=$DOMAIN
FABRIC_DNS=$FABRIC_DNS
MANAGED_PENDING=$MANAGED_PENDING
JOINED=$(date +%s)
HOST_AT_JOIN=$(hostname -s | tr 'A-Z' 'a-z')
EOF
cat > /usr/local/sbin/fabric-managed <<'MANAGED'
#!/bin/bash
# fabric's configuration of a machine it manages (manual 1.6.11.6), installed by join-linux.sh:
#   fabric-managed apply | remove | check     (check: apply while in fabric-managed, remove when not)
set -euo pipefail
. /etc/fabric/managed.env
# 10-: sshd keeps the first value it reads, and Ubuntu's cloud images set passwords on in 50-cloud-init.conf
SSHD=/etc/ssh/sshd_config.d/10-fabric.conf
RESOLVED=/etc/systemd/resolved.conf.d/fabric.conf

reload() {
    systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
    systemctl try-restart systemd-resolved 2>/dev/null || true
}
write() {   # write $1 from stdin if it differs; true when it changed
    local tmp="$1.tmp"
    cat > "$tmp"
    if cmp -s "$tmp" "$1"; then rm -f "$tmp"; return 1; fi
    mv "$tmp" "$1"
}
apply() {
    local changed=0
    if [[ -d /etc/ssh/sshd_config.d ]]; then
        printf '%s\n' "# fabric (manual 1.6.11.6): domain sign-in with Kerberos; who may sign in is the domain's (1.6.13.4)" \
            "GSSAPIAuthentication yes" "GSSAPICleanupCredentials yes" "PasswordAuthentication no" \
            "KbdInteractiveAuthentication no" "UsePAM yes" | write "$SSHD" && changed=1
    fi
    mkdir -p /etc/systemd/resolved.conf.d
    printf '[Resolve]\n# fabric (manual 1.6.11.6): the domain names from fabric; other names as the machine had them\nDNS=%s\nDomains=~%s ~%s\n' \
        "$FABRIC_DNS" "$AD_DOMAIN" "$DOMAIN" | write "$RESOLVED" && changed=1
    if [[ $changed -eq 1 ]]; then reload; echo "fabric-managed: applied"; fi
}
remove() {
    if [[ -e $SSHD || -e $RESOLVED ]]; then
        rm -f "$SSHD" "$RESOLVED"
        reload
        echo "fabric-managed: removed (no longer in fabric-managed)"
    fi
}
member() {  # whether this machine is in fabric-managed, asked of the DC as the machine itself
    local cc
    cc=$(mktemp)
    trap 'rm -f "$cc"' RETURN
    KRB5CCNAME="FILE:$cc" kinit -k "${MACHINE^^}\$@$REALM" >/dev/null 2>&1 || return 2
    KRB5CCNAME="FILE:$cc" LDAPSASL_NOCANON=on ldapsearch -LLL -o ldif-wrap=no -Q -Y GSSAPI -H "ldap://$DC" \
        -b "$BASE_DN" "(sAMAccountName=${MACHINE^^}\$)" memberOf 2>/dev/null | grep -qi "^memberOf: CN=fabric-managed,"
}
renamed() {  # the machine renamed since its join (1.6.7.9, 2.1.6.96): its domain account still has the old name
    local now
    now=$(hostname -s | tr 'A-Z' 'a-z')
    if [[ -n ${HOST_AT_JOIN:-} && $now != "$HOST_AT_JOIN" ]]; then
        echo "fabric-managed: warning: this machine is now named $now, but it joined the domain as $HOST_AT_JOIN" \
             "(account ${MACHINE^^}\$); its domain sign-in breaks. Name it $HOST_AT_JOIN again, or leave, rename and" \
             "join again (manual 4.6.6.11)" >&2
    fi
}
case "${1:-check}" in
    apply) apply ;;
    remove) remove ;;
    check)
        renamed
        rc=0; member || rc=$?
        # the guard (2.1.6.97): a managed join that could not add itself to fabric-managed keeps its configuration
        # for 2 hours, so the root's hourly sort can add it first (one an admin took out is removed at once)
        if [[ $rc -eq 1 && ${MANAGED_PENDING:-0} -eq 1 && $(( $(date +%s) - ${JOINED:-0} )) -lt 7200 ]]; then
            echo "fabric-managed: not in fabric-managed yet; kept (joined under 2 hours ago: fabric's hourly sort adds it)"
        elif [[ $rc -eq 0 ]]; then apply; elif [[ $rc -eq 1 ]]; then remove; else echo "fabric-managed: the DC did not answer; nothing changed" >&2; exit 1; fi ;;
    *) echo "usage: fabric-managed apply|remove|check" >&2; exit 2 ;;
esac
MANAGED
chmod 0755 /usr/local/sbin/fabric-managed
# a service's keytab (manual 1.6.12.9): the console shows the machine's administrator one command to run here with sudo
{% raw %}
cat > /usr/local/sbin/fabric-keytab <<'KEYTAB'
#!/bin/bash
# A Kerberos keytab for a service on this machine (manual 1.6.12.9), installed by join-linux.sh:
#   sudo fabric-keytab --machine <this machine> --service <class, e.g. HTTP> --user <the service's user> [--path <file>]
# Adds <class>/<this machine's names> to its own computer account with its own domain account (/etc/krb5.keytab:
# AD lets a machine add its own names), then writes the service's keytab (default /etc/krb5-<class>.keytab), owned by
# the user, mode 0600. Nothing secret is given to it; whoever may sudo here may install a key.
set -euo pipefail
die() { echo "fabric-keytab: $*" >&2; exit 1; }
[[ $EUID -eq 0 ]] || die "run it with sudo"
WANT="" SERVICE="" OWNER="" KT=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --machine) WANT="${2:-}"; shift 2 ;;
        --service) SERVICE="${2:-}"; shift 2 ;;
        --user) OWNER="${2:-}"; shift 2 ;;
        --path) KT="${2:-}"; shift 2 ;;
        *) die "usage: fabric-keytab --machine <name> --service <class> --user <user> [--path <file>]" ;;
    esac
done
[[ -f /etc/fabric/managed.env && -s /etc/krb5.keytab ]] || die "this machine is not joined to fabric's domain (no /etc/krb5.keytab)"
. /etc/fabric/managed.env
[[ $WANT == "$MACHINE" ]] || die "the command is for ${WANT:-?}, but this machine is $MACHINE: run it on ${WANT:-that machine}"
[[ $SERVICE =~ ^[A-Za-z][A-Za-z0-9-]{0,31}$ ]] || die "--service is a service class, such as HTTP: $SERVICE"
case "${SERVICE,,}" in host|restrictedkrbhost|cifs) die "$SERVICE is the machine's own name: it is in /etc/krb5.keytab already" ;; esac
id "$OWNER" >/dev/null 2>&1 || die "no user $OWNER on this machine"
KT="${KT:-/etc/krb5-${SERVICE,,}.keytab}"
[[ $KT == /* && $KT != /etc/krb5.keytab ]] || die "--path is an absolute path other than /etc/krb5.keytab: $KT"
cc=$(mktemp); trap 'rm -f "$cc" "$KT.tmp"' EXIT
KRB5CCNAME="FILE:$cc" kinit -k "${MACHINE^^}\$@$REALM" >/dev/null 2>&1 || die "the machine's own domain account did not sign in (is the DC reachable?)"
FQDN=$(KRB5CCNAME="FILE:$cc" LDAPSASL_NOCANON=on ldapsearch -LLL -o ldif-wrap=no -Q -Y GSSAPI -H "ldap://$DC" \
    -b "$BASE_DN" "(sAMAccountName=${MACHINE^^}\$)" dNSHostName 2>/dev/null | sed -n 's/^dNSHostName: //p')
[[ -n $FQDN ]] || die "the DC does not know $MACHINE as joined"
for name in "${FQDN,,}" "${MACHINE^^}"; do
    adcli update --domain="$AD_DOMAIN" --domain-controller="$DC" --add-service-principal="$SERVICE/$name" >/dev/null \
        || die "the DC refused $SERVICE/$name on $MACHINE's account (taken by another account?)"
done
mapfile -t names < <(klist -k /etc/krb5.keytab | awk 'NR>3 {print $2}')
script="rkt /etc/krb5.keytab"
for (( i=${#names[@]}; i>=1; i-- )); do
    [[ ${names[$((i-1))],,} == "${SERVICE,,}/"* ]] || script+=$'\n'"delent $i"
done
printf '%s\nwkt %s\nquit\n' "$script" "$KT.tmp" | ktutil >/dev/null
[[ -s $KT.tmp ]] || die "no key for $SERVICE was written"
chown "$OWNER" "$KT.tmp"; chmod 0600 "$KT.tmp"; mv "$KT.tmp" "$KT"
echo "fabric-keytab: $SERVICE/${FQDN,,} and $SERVICE/${MACHINE^^} on ${MACHINE^^}\$; keytab $KT ($(klist -k "$KT" | awk 'NR>3' | wc -l) keys), owned by $OWNER, 0600"
KEYTAB
{% endraw %}
chmod 0755 /usr/local/sbin/fabric-keytab
cat > /etc/systemd/system/fabric-managed.service <<'EOF'
[Unit]
Description=fabric: this machine's managed configuration, as its membership says (manual 1.6.11.6)
After=network-online.target sssd.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fabric-managed check
EOF
cat > /etc/systemd/system/fabric-managed.timer <<'EOF'
[Unit]
Description=fabric: check this machine's managed configuration hourly (manual 1.6.11.6)

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h

[Install]
WantedBy=timers.target
EOF
systemctl daemon-reload 2>/dev/null || true
systemctl enable --now fabric-managed.timer >/dev/null 2>&1 || true
if [[ $MANAGED -eq 1 ]]; then
    /usr/local/sbin/fabric-managed apply
    echo "managed by fabric: SSH with Kerberos (passwords off; keys still work), the domain's names from fabric's DNS"
else
    echo "unmanaged: fabric configures nothing more here"
fi
# the machine's name is its domain account's: renaming it breaks the join (manual 1.6.7.9, 2.1.6.96). polkit refuses
# hostnamed's renames to everyone it asks (the desktop's settings, hostnamectl without root); /etc/hostname says why
# to whoever edits it. Root's own hostnamectl and hostname are not asked of polkit: the hourly check warns of those
mkdir -p /etc/polkit-1/rules.d
cat > /etc/polkit-1/rules.d/10-fabric-hostname.rules <<EOF
// fabric (manual 1.6.7.9, 4.6.6.11): this machine joined $AD_DOMAIN as ${MACHINE^^}\$; a new name breaks that.
// To rename it: leave the domain, rename it, join again (manual 4.6.6.11).
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.hostname1.set-hostname" ||
        action.id == "org.freedesktop.hostname1.set-static-hostname") {
        polkit.log("fabric: renaming this machine refused for " + subject.user +
                   ": it joined $AD_DOMAIN as ${MACHINE^^}\$; leave, rename, join again (manual 4.6.6.11)");
        return polkit.Result.NO;
    }
});
EOF
chmod 0644 /etc/polkit-1/rules.d/10-fabric-hostname.rules
if [[ -f /etc/hostname ]] && ! grep -q '^# fabric' /etc/hostname; then
    { printf '# fabric: this name is the domain account %s$ (%s); a new one breaks the join.\n' "${MACHINE^^}" "$AD_DOMAIN"
      printf '# To rename: leave the domain, rename, join again (manual 4.6.6.11).\n'
      grep -v '^#' /etc/hostname; } > /etc/hostname.fabric && cat /etc/hostname.fabric > /etc/hostname
    rm -f /etc/hostname.fabric
fi
systemctl restart sssd
systemctl enable sssd >/dev/null 2>&1 || true
echo "done: the domain's grants decide who logs on here and who has sudo (manual 1.6.13.4; a machine no grant reaches admits nobody from the domain)"
