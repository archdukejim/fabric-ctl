{# ----------------------------------------------------------------- #}
{# nginx.conf — rendered by fabricctl from nginx/nginx.conf.j2         #}
{# ----------------------------------------------------------------- #}

{# How the CA certificate files are served (/certs/ on every name over HTTP, http://<host_ip>/certs/ and
   http://ca.<domain>/certs/ among them, and on the landing names over HTTPS; manual 1.5.1.5, 1.5.1.6): the MIME types
   operating systems recognise; .pem/.json readable in the browser, the rest downloads. #}
{% macro cert_file_types() %}
            location ~ \.pem$ {
                default_type text/plain;
                types { }
                charset utf-8;
            }
            location ~ \.json$ {
                default_type application/json;
                types { }
            }
            location ~ \.crt$ {
                default_type application/x-x509-ca-cert;
                types { }
                add_header Content-Disposition 'attachment' always;
                add_header X-Content-Type-Options nosniff always;
            }
            location ~ \.(cer|der)$ {
                default_type application/pkix-cert;
                types { }
                add_header Content-Disposition 'attachment' always;
                add_header X-Content-Type-Options nosniff always;
            }
            location ~ \.p7b$ {
                default_type application/x-pkcs7-certificates;
                types { }
                add_header Content-Disposition 'attachment' always;
                add_header X-Content-Type-Options nosniff always;
            }
            location ~ \.sh$ {
                default_type text/x-shellscript;
                types { }
                add_header Content-Disposition 'attachment' always;
                add_header X-Content-Type-Options nosniff always;
            }
{% endmacro %}
{# The landing page at /info/ (2.1.4.6, manual 1.4.2.5): on every name over HTTP and on the landing names #}
{% macro landing_path() %}
        location = /info {
            return 301 /info/;
        }
        location /info/ {
            alias /srv/www/landing/;
            index index.html;
            default_type text/html;
        }
{% endmacro %}
{# The names the landing page answers at / with its certificate: hostname_landing, <domain> and the host's own name.
   The host's own name is fabric's (refused in the DNS tab), so links that must work whatever the admin does to the
   info alias use it. #}
{% set _host_fqdn = (hostname ~ '.' ~ domain) | lower %}
{% set _landing_names = [hostname_landing, domain, _host_fqdn] | unique | list %}

# Global settings
worker_processes  auto;
worker_rlimit_nofile 65535;
error_log  /var/log/nginx/error.log notice;
pid        /tmp/nginx.pid;

events {
    multi_accept on;
    worker_connections  16384;
}

# DNS / LDAP stream proxies
stream {
    resolver 127.0.0.11 valid=30s;

}

http {
    include       /etc/nginx/mime.types;
    include       /etc/nginx/conf.d/*.conf;
    default_type  application/octet-stream;

    # Non-root user (UID {{ service_users.nginx.uid }}) temp paths
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path       /tmp/proxy_temp;
    fastcgi_temp_path     /tmp/fastcgi_temp;
    uwsgi_temp_path       /tmp/uwsgi_temp;
    scgi_temp_path        /tmp/scgi_temp;

    resolver 127.0.0.11 valid=30s;

    # fabric's HTTPS services: plain HTTP to them goes to HTTPS; any other name pointing at this host (an alias the
    # admin keeps, such as info.<domain> renamed) gets the landing page at /info/ (2.1.4.6)
    map $host $fabric_https_name {
        default 0;
{% for _n in ([hostname_bind9, hostname_stepca, hostname_openbao]
              + ([hostname_keycloak] if install_keycloak | default(false) | bool else [])
              + ([hostname_federation] if federation_endpoint | default(false) | bool else [])
              + ([hostname_mgr] if install_webui | default(false) | bool else [])) | map('lower') | unique %}
        {{ _n }} 1;
{% endfor %}
    }

    # HTTP — health check, CA certificates (/certs/), the landing page (/info/); fabric's services to HTTPS
    server {
        listen 80 default_server;
        server_name _;

        location /health {
            access_log off;
            return 200 'OK';
        }

        # CA certificates without DNS or TLS: http://<host_ip>/certs/
        location = /certs {
            return 301 /certs/;
        }
        location /certs/ {
            root /srv/www;
            index index.html;
{{ cert_file_types() }}        }
        location = /style.css {
            root /srv/www/shared;
        }
{{ landing_path() }}
        # the page's manual link: HTTPS at the host's own name (this name or address may have no certificate)
        location /manual/ {
            return 301 https://{{ _host_fqdn }}$request_uri;
        }

        location / {
            if ($fabric_https_name) {
                return 301 https://$host$request_uri;
            }
            return 302 /info/;
        }
    }

    # HTTPS — DNS-over-HTTPS via BIND9
    # nginx terminates TLS; BIND9 serves plain HTTP DoH on port {{ bind9_doh_port }}.
    server {
        listen 443 ssl;
        server_name {{ hostname_bind9 }};

        ssl_certificate     /etc/nginx/certs/{{ hostname_bind9 }}/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/{{ hostname_bind9 }}/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;

        location /dns-query {
            # BIND's DoH speaks HTTP/2 only: grpc_pass is nginx's cleartext HTTP/2 to an upstream (proxy_pass speaks
            # HTTP/1.1, and BIND's answer came back as an HTTP/0.9 blob; found by doctor's DoH check, 0.6.3)
            # the DNS filter answers DoH when it is on (filtered, internet names too: 1.12.2.16), else BIND
            set $bind9_doh_backend "{{ 'grpc://resolver:8053' if install_resolver else 'grpc://bind9:' ~ bind9_doh_port }}";
            grpc_pass $bind9_doh_backend;
            grpc_set_header Host $host;
            grpc_set_header X-Real-IP $remote_addr;
            grpc_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }

    # Step-CA — pass HTTPS through to Step-CA's native TLS on port {{ stepca_port }}
    server {
        listen 443 ssl;
        server_name {{ hostname_stepca }};

        ssl_certificate     /etc/nginx/certs/{{ hostname_stepca }}/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/{{ hostname_stepca }}/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;

        set $stepca_backend "{{ nginx_backend_stepca }}";

        # Step-CA's API / ACME only. People opening ca.<domain> in a browser (or an old /certificates link) get the
        # certificate page at the host's own name, a name fabric keeps (1.5.1.5, 2.1.4.6).
        location = / {
            return 302 https://{{ _host_fqdn }}/certs/;
        }
        location /certificates {
            return 301 https://{{ _host_fqdn }}/certs/;
        }

        location / {
            proxy_pass $stepca_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify off;
        }
    }

    # The landing page (decisions 2.1.4.3, 2.1.4.6) on its names (hostname_landing, <domain>, the host's own name):
    # also over plain HTTP with no redirect, so a new device can fetch the CA (/certs/) and check its fingerprint
    # before it trusts anything; the manual stays on HTTPS
    server {
        listen 80;
        server_name {{ _landing_names | join(' ') }};

        location /health {
            access_log off;
            return 200 'OK';
        }
        location = /style.css {
            alias /srv/www/shared/style.css;
        }
        location = /certs {
            return 301 /certs/;
        }
        location /certs/ {
            root /srv/www;
            index index.html;
{{ cert_file_types() }}        }
        location /manual/ {
            return 301 https://$host$request_uri;
        }
{{ landing_path() }}
        location / {
            alias /srv/www/landing/;
            index index.html;
            default_type text/html;
        }
    }

    # The landing page over HTTPS (Landing, Certificates, Manual) on the same names: <domain> and the host's own name
    # serve it themselves since 0.7.1 instead of redirecting to info.<domain>, which the admin may change (2.1.4.6)
    server {
        listen 443 ssl;
        server_name {{ _landing_names | join(' ') }};

        ssl_certificate     /etc/nginx/certs/{{ hostname_landing }}/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/{{ hostname_landing }}/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;

        location = /style.css {
            alias /srv/www/shared/style.css;
        }

        location / {
            alias /srv/www/landing/;
            index index.html;
            default_type text/html;
        }

        location /manual/ {
            alias /srv/www/manual/;
            index index.html;
            default_type text/html;
        }
{{ landing_path() }}
        # CA certificates for every kind of system (published by fabricctl setup:
        # fabriclib/pki/publish_ca_certs.py), here and on plain HTTP above (certs.<domain> was dropped, 1.5.1.5).
        # Integrity: compare the fingerprints shown on the page.
        location /certificates {
            return 301 /certs/;
        }
        location = /certs {
            return 301 /certs/;
        }
        location /certs/ {
            root /srv/www;
            index index.html;
{{ cert_file_types() }}        }
    }

    # OpenBao API + UI (TLS to the backend verified against the fabric root CA)
    server {
        listen 443 ssl;
        server_name {{ hostname_openbao }};

        ssl_certificate /etc/nginx/certs/{{ hostname_openbao }}/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/{{ hostname_openbao }}/privkey.pem;
        client_max_body_size 1m;

        location / {
            set $openbao_backend "https://openbao:8200";
            proxy_pass $openbao_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify on;
            proxy_ssl_trusted_certificate /etc/nginx/certs/{{ hostname_openbao }}/root_ca.crt;
            proxy_ssl_name {{ hostname_openbao }};
            proxy_ssl_server_name on;
        }
    }

{% if install_keycloak | default(false) | bool %}
    # Keycloak Web UI / API
    server {
        listen 443 ssl;
        server_name {{ hostname_keycloak }};

        ssl_certificate /etc/nginx/certs/{{ hostname_keycloak }}/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/{{ hostname_keycloak }}/privkey.pem;

        location / {
            set $keycloak_backend "https://keycloak:8443";
            proxy_pass $keycloak_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port 443;
            proxy_ssl_verify off;
        }
    }
{% endif %}
{% if federation_endpoint | default(false) | bool %}

    # Federation endpoint (manual 1.9.4.2): other sites join here. A join
    # is authenticated by its one-time invitation secret; the joining node has no
    # certificate yet. Small bodies, few requests.
    limit_req_zone $binary_remote_addr zone=federation:1m rate=6r/m;
    server {
        listen 443 ssl;
        server_name {{ hostname_federation }};

        ssl_certificate     /etc/nginx/certs/{{ hostname_federation }}/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/{{ hostname_federation }}/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_session_tickets off;
        client_max_body_size 16k;

        location = /v1/health {
            proxy_pass http://unix:/srv/federation/federation.sock:;
            proxy_set_header X-Real-IP $remote_addr;
        }
        location = /v1/join {
            limit_req zone=federation burst=3 nodelay;
            limit_req_status 429;
            proxy_pass http://unix:/srv/federation/federation.sock:;
            proxy_read_timeout 180s;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
        location / {
            return 404;
        }
    }
{% endif %}
{% if install_webui | default(false) | bool %}

    # webui management UI — Keycloak OIDC in the app; with webui_client_cert, mutual TLS first (manual 2.3.6.2.6.3)
    server {
        listen 443 ssl;
        server_name {{ hostname_mgr }};

        ssl_certificate     /etc/nginx/certs/{{ hostname_mgr }}/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/{{ hostname_mgr }}/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_session_tickets off;

        # Only certificates issued directly by this site's Step-CA intermediate:
        # depth 2 = leaf -> intermediate -> root, plus one per parent CA of a
        # nested site (site_ca_depth). Leaves under a subordinate CA minted
        # with --intermediate-ca are one level deeper and fail.
        ssl_client_certificate /etc/nginx/certs/client-ca/ca-bundle.pem;
        # revoked client certificates refused (2.1.5.10): ssl_crl, written by fabriclib/pki/publish_crl.py
        include /etc/nginx/conf.d/client-crl.inc;
        ssl_verify_depth {{ 2 + (site_ca_depth | default(0) | int) }};
{% if webui_client_cert | default(false) | bool %}
        ssl_verify_client on;
{% else %}
        # webui_client_cert off (2.1.8.2): a certificate is only asked for, never required; the web app skips its
        # certificate gates and reads one only before turning the setting on (the admin's own, manual 2.3.6.2.6.4)
        ssl_verify_client optional;
{% endif %}

        add_header Strict-Transport-Security "max-age=31536000" always;
        client_max_body_size 64k;

        location / {
            proxy_pass http://unix:/srv/webui/web.sock:;
            proxy_http_version 1.1;
            proxy_read_timeout 900s;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            # Always overwritten here, so a client can never supply them.
            proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
            proxy_set_header X-SSL-Client-S-DN $ssl_client_s_dn;
            proxy_set_header X-SSL-Client-I-DN $ssl_client_i_dn;
            proxy_set_header X-SSL-Client-Fingerprint $ssl_client_fingerprint;
        }
    }
{% endif %}
}
