services:
  bind9-resolver:
    # The DNS filter (manual 1.12.2, 1.12.3): a second BIND that answers clients on host_ip:53 with the owner's rules,
    # safe search and the groups, and forwards everything else to AdGuard Home (the lists); fabric's zones go to the
    # authoritative BIND, never filtered. fabric's bind9 image (built by the bind9 unit when not published), its own
    # account and config.
    image: {{ published_ref('bind9') or 'fabric/bind9:local' }}
    container_name: bind9-resolver
    logging:
      driver: journald
      options:
        tag: "{{ '{{.Name}}' }}"
    user: "{{ service_users.resolver.uid }}:{{ service_users.resolver.gid }}"
    # -f, not the image's -g: -g ignores the logging statement (the query and RPZ logs, 2.3.12.1.16)
    entrypoint: ["/usr/sbin/named", "-f", "-c", "/etc/bind/named.conf"]
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    tmpfs:
      - /run/named:uid={{ service_users.resolver.uid }},gid={{ service_users.resolver.gid }},mode=0755,size=4m
      - /tmp:noexec,nosuid,size=8m
    ports:
      - "{{ host_ip }}:53:53/tcp"
      - "{{ host_ip }}:53:53/udp"
      # DNS-over-TLS for clients (1.12.2.16); DoH comes through nginx to 8053 on fabric_net, never published
      - "{{ host_ip }}:853:853/tcp"
{# fabric's address on each network DHCP serves, full or guest (manual 1.10.3.3) #}
{% set _served = dhcp_served | default({}) %}
{% for addr in ((_served.full_addrs | default([])) + (_served.guest_addrs | default([]))) | unique if addr != host_ip %}
      - "{{ addr }}:53:53/tcp"
      - "{{ addr }}:53:53/udp"
      - "{{ addr }}:853:853/tcp"
{% endfor %}
    volumes:
      - {{ deploy_base_dir }}/resolver/config:/etc/bind:ro
      # the DNS name's certificate (mint_service_certs), for DoT and DoH
      - {{ deploy_base_dir }}/resolver/tls:/etc/bind-tls:ro
      - {{ deploy_base_dir }}/resolver/log:/var/log/named
      - {{ deploy_base_dir }}/resolver/cache:/var/cache/bind
    networks:
      fabric_net:
        ipv4_address: "{{ ip_resolver }}"
        aliases:
          - resolver
    mem_limit: {{ memory_mb('resolver') }}m
    healthcheck:
      test: ["CMD", "rndc", "-k", "/etc/bind/rndc.key", "status"]
      interval: 15s
      start_period: 30s
      timeout: 5s
      retries: 3

networks:
  fabric_net:
    name: fabric_net
    external: true
