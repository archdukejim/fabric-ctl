; the owner's rules (manual 1.12.2.7, 1.12.3.6): dns_filter_allow beats every list (an allow rule in AdGuard Home too),
; dns_filter_block applies whatever they say; each name with every name below it
$TTL 300
@ SOA localhost. hostmaster.owner.rpz. 1 3600 600 86400 300
@ NS localhost.
{% for n in dns_filter_allow %}
{{ n }} CNAME rpz-passthru.
*.{{ n }} CNAME rpz-passthru.
{% endfor %}
{% for n in dns_filter_block %}
{{ n }} CNAME .
*.{{ n }} CNAME .
{% endfor %}
