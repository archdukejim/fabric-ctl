// fabric's DNS filter: the BIND resolver (manual 1.12.2, 1.12.3). Rendered at every apply: do not edit here.
include "/etc/bind/rndc.key";
controls { inet 127.0.0.1 port 953 allow { 127.0.0.1; } keys { "rndc-key"; }; };

{% if client_tls %}
// DNS-over-TLS and DNS-over-HTTPS for clients (manual 1.12.2.16): the DNS name's certificate
tls "clients" { cert-file "/etc/bind-tls/fullchain.pem"; key-file "/etc/bind-tls/privkey.pem"; protocols { TLSv1.2; TLSv1.3; }; };
http "doh" { endpoints { "/dns-query"; }; };
{% endif %}
{% if adguard_tls %}
{% for g in groups %}
// group {{ g.name }} reaches AdGuard Home over DNS-over-TLS naming its group: AdGuard's ClientID (1.12.3.6)
tls "group-{{ g.name }}" { ca-file "/etc/bind/fabric-root-ca.crt"; remote-hostname "{{ g.name }}.filter.{{ domain }}"; };
{% endfor %}
{% endif %}
// the networks that may use it: the LAN, fabric's own, and what the firewall lets in
acl "clients" { {% for c in clients %}{{ c }}; {% endfor %}127.0.0.1; };

options {
    directory "/var/cache/bind";
    session-keyfile "/var/cache/bind/session.key";
    listen-on port 53 { any; };
{% if client_tls %}
    listen-on port 853 tls "clients" { any; };
    // DoH: nginx terminates TLS and passes cleartext HTTP/2 here (fabric_net only, not published)
    listen-on port 8053 tls none http "doh" { any; };
{% endif %}
    listen-on-v6 { none; };
    recursion yes;
    allow-query { clients; };
    allow-recursion { clients; };
    allow-query-cache { clients; };
    allow-transfer { none; };
    // DNSSEC validated here (2.1.12.7): a resolver that does not validate sets CD on what it forwards, so nothing
    // upstream would. AdGuard passes every DS query, so a blocked name in an unsigned zone stays NXDOMAIN; fabric's
    // own zones are never signed
    dnssec-validation auto;
    validate-except { {% for z in zones %}"{{ z }}"; {% endfor %}};
    // no answer kept more than 5 minutes, a miss neither: then asked again (and validated) or dropped (2.1.12.11);
    // BIND's defaults are a week and 3 hours. fabric's own zones keep a miss only 30 s (their SOA, 2.1.4.9); a
    // client group's view none (below)
    max-cache-ttl 300;
    max-ncache-ttl 300;
    querylog yes;
    // each answer logged after its query, for the query log (1.12.3.7)
    responselog yes;
    version none;
    hostname none;
    server-id none;
};

logging {
    channel default_out { stderr; severity info; print-time yes; print-category yes; print-severity yes; };
    channel queries { file "/var/log/named/query.log" versions 2 size 20m; print-time yes; };
    channel rpz { file "/var/log/named/rpz.log" versions 2 size 20m; print-time yes; };
    category default { default_out; };
    category queries { queries; };
    category responses { queries; };
    category rpz { rpz; };
    category lame-servers { null; };
};

{% macro own_zones() %}
{% for z in zones %}
    zone "{{ z }}" { type forward; forward only; forwarders { {{ ip_bind9 }} port 53; }; };
{% endfor %}
    zone "fabric.rpz" { type primary; file "/etc/bind/fabric.rpz"; };
    zone "owner.rpz" { type primary; file "/etc/bind/owner.rpz"; };
{% endmacro %}
{% for g in groups %}
// client group {{ g.name }} (manual 1.12.2.15, 1.12.3.6): fabric's zones, its own rules, the owner's, its safe search;
// everything else to AdGuard Home as the group {{ g.name }}
view "{{ g.name }}" {
    match-clients { {% for m in g.match %}{{ m }}; {% endfor %}};
    // a group's view keeps no "no such name" (2.1.12.11, the owner 2026-10-31); answers keep the options' 300 s cap
    max-ncache-ttl 0;
    forward only;
{% if adguard_tls %}
    forwarders port 853 tls "group-{{ g.name }}" { {{ ip_adguard }}; };
{% else %}
    // no certificate for *.filter.{{ domain }} yet: plain DNS (the group's AdGuard rules wait for it)
    forwarders { {{ ip_adguard }} port 53; };
{% endif %}
{{ own_zones() }}    zone "{{ g.rules_zone }}" { type primary; file "/etc/bind/{{ g.rules_zone }}"; };
{% if g.safe_zone %}
    zone "{{ g.safe_zone }}" { type primary; file "/etc/bind/{{ g.safe_zone }}"; };
{% endif %}
    // first match wins: fabric's zones never filtered, the group's own allows and blocks, the owner's, safe search
    response-policy {
        zone "fabric.rpz";
        zone "{{ g.rules_zone }}";
        zone "owner.rpz";
{% if g.safe_zone %}
        zone "{{ g.safe_zone }}";
{% endif %}
    } break-dnssec yes qname-wait-recurse no;
};

{% endfor %}
view "everyone" {
    match-clients { any; };
    // everything that is not fabric's goes to AdGuard Home, which matches the lists (1.12.3.2)
    forward only;
    forwarders { {{ ip_adguard }} port 53; };
{{ own_zones() }}{% if safe_zone %}
    zone "{{ safe_zone }}" { type primary; file "/etc/bind/{{ safe_zone }}"; };
{% endif %}
    // first match wins: fabric's zones are never filtered, then the owner's rules, safe search
    response-policy {
        zone "fabric.rpz";
        zone "owner.rpz";
{% if safe_zone %}
        zone "{{ safe_zone }}";
{% endif %}
    } break-dnssec yes qname-wait-recurse no;
};
